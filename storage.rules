rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn()
        && (
          request.auth.token.email_verified == true
          // Temporary admin bypass: allow admin/super_admin even when
          // email_verified is false, provided they have approved status.
          // TODO: Remove this bypass once admin emails are verified.
          || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved')
        );
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedVerifiedUser() {
      return isVerified()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().status == 'approved';
    }

    function enrollmentDocId(uid, courseId) {
      return uid + ':' + courseId;
    }

    function isSafeImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isSafeStatusUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20971520
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'video/mp4', 'video/quicktime'];
    }



    function isSafeChatMediaUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20971520
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp',
          'video/mp4', 'video/quicktime',
          'audio/mpeg', 'audio/mp4', 'audio/aac', 'audio/wav', 'audio/m4a', 'audio/x-m4a',
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'text/plain'
        ];
    }

    function canReadChatMedia(chatId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    function hasActiveEnrollmentForCourse(courseId) {
      return isApprovedVerifiedUser()
        && courseId is string
        && courseId.size() > 0
        && firestore.exists(/databases/(default)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId)))
        && firestore.get(/databases/(default)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId))).data.user_id == request.auth.uid
        && firestore.get(/databases/(default)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId))).data.course_id == courseId
        && firestore.get(/databases/(default)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId))).data.status == 'active';
    }

    function isLiveClassTeacherOrAdmin(data) {
      return isApprovedVerifiedUser()
        && (
          userDoc().role in ['admin', 'super_admin']
          || (userDoc().role in ['teacher', 'assistant_teacher'] && data.teacher_id == request.auth.uid)
        );
    }

    function canReadLiveClassStorage(classId) {
      return isApprovedVerifiedUser()
        && firestore.exists(/databases/(default)/documents/live_classes/$(classId))
        && (
          isLiveClassTeacherOrAdmin(firestore.get(/databases/(default)/documents/live_classes/$(classId)).data)
          || hasActiveEnrollmentForCourse(firestore.get(/databases/(default)/documents/live_classes/$(classId)).data.course_id)
        );
    }

    function isSafeAudioLessonUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 104857600
        && request.resource.contentType in ['audio/mpeg', 'audio/mp4', 'audio/m4a', 'audio/x-m4a', 'audio/aac', 'audio/aacp'];
    }

    function isSafeCourseMaterialUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 52428800
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/jpeg',
          'image/png',
          'image/webp',
          'video/mp4',
          'video/quicktime'
        ];
    }


    function isAdmin() {
      return isApprovedVerifiedUser()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isTeacherOrAdmin() {
      return isApprovedVerifiedUser()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin', 'super_admin']
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isSafeAssignmentUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10485760
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function canReadCourseStorage(courseId) {
      return isApprovedVerifiedUser()
        && (
          userDoc().role in ['teacher', 'admin', 'super_admin']
          || (firestore.exists(/databases/(default)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId)))
            && firestore.get(/databases/(default)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId))).data.user_id == request.auth.uid
            && firestore.get(/databases/(default)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId))).data.course_id == courseId
            && firestore.get(/databases/(default)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId))).data.status == 'active')
        );
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isApprovedVerifiedUser() && request.auth.uid == userId;
      allow write: if isVerified() && request.auth.uid == userId && isSafeImageUpload(5242880);
    }

    match /status_updates/{userId}/{fileName} {
      allow read: if isApprovedVerifiedUser() && request.auth.uid == userId;
      allow write: if isVerified() && request.auth.uid == userId && isSafeStatusUpload();
    }


    match /chat_media/{chatId}/{userId}/{fileName} {
      allow read: if canReadChatMedia(chatId);
      allow write: if isApprovedVerifiedUser()
        && request.auth.uid == userId
        && fileName.matches('^[A-Za-z0-9._-]{6,160}$')
        && canReadChatMedia(chatId)
        && isSafeChatMediaUpload();
    }

    match /course_materials/{courseId}/{fileName} {
      allow read: if canReadCourseStorage(courseId);
      allow write: if isTeacherOrAdmin()
        && fileName.matches('^[A-Za-z0-9._-]{6,160}$')
        && isSafeCourseMaterialUpload();
    }

    match /audio_lessons/{courseId}/{teacherId}/{fileName} {
      allow read: if canReadCourseStorage(courseId);
      allow create, update: if isTeacherOrAdmin()
        && request.auth.uid == teacherId
        && fileName.matches('^[A-Za-z0-9._-]{6,180}$')
        && isSafeAudioLessonUpload();
      allow delete: if isAdmin() || (isTeacherOrAdmin() && request.auth.uid == teacherId);
    }


    match /live_classes/{classId}/{allPaths=**} {
      allow read: if canReadLiveClassStorage(classId);
      allow write: if false;
    }

    match /recordings/{classId}/{fileName} {
      allow read: if isApprovedVerifiedUser();
      allow create, update: if isTeacherOrAdmin()
        && request.resource.size <= 209715200
        && request.resource.contentType in ['audio/mp4', 'audio/m4a', 'audio/x-m4a', 'audio/aac', 'audio/mpeg', 'audio/webm'];
      allow delete: if isTeacherOrAdmin();
    }

    match /assignment_submissions/{userId}/{fileName} {
      allow read: if isApprovedVerifiedUser() && (request.auth.uid == userId || isTeacherOrAdmin());
      allow write: if isApprovedVerifiedUser()
        && request.auth.uid == userId
        && fileName.matches('^[A-Za-z0-9._-]{6,140}$')
        && isSafeAssignmentUpload();
    }

    // ── Certificate PDFs ──────────────────────────────────────────────────────
    // Generated server-side by generateCertificate Cloud Function (Admin SDK).
    // Owner can read their own certificate PDF.
    // Client writes are denied — Admin SDK bypasses these rules intentionally.
    match /certificates/{userId}/{fileName} {
      allow read: if isApprovedVerifiedUser() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
