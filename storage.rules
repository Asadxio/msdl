rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSafeImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isSafeStatusUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20971520
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'video/mp4', 'video/quicktime'];
    }



    function isSafeChatMediaUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20971520
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'video/mp4', 'video/quicktime', 'audio/mpeg', 'audio/mp4', 'audio/aac', 'audio/wav'];
    }

    function canReadChatMedia(chatId) {
      return isSignedIn()
        && exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    function canReadLiveClassStorage(classId) {
      return isSignedIn()
        && exists(/databases/(default)/documents/live_classes/$(classId))
        && (
          get(/databases/(default)/documents/live_classes/$(classId)).data.teacher_id == request.auth.uid
          || (get(/databases/(default)/documents/live_classes/$(classId)).data.student_ids is list
            && request.auth.uid in get(/databases/(default)/documents/live_classes/$(classId)).data.student_ids)
          || (exists(/databases/(default)/documents/users/$(request.auth.uid))
            && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
        );
    }

    function isSafeAudioLessonUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 104857600
        && request.resource.contentType in ['audio/mpeg', 'audio/mp4', 'audio/m4a', 'audio/x-m4a', 'audio/aac', 'audio/aacp'];
    }

    function isSafeCourseMaterialUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 52428800
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/jpeg',
          'image/png',
          'image/webp',
          'video/mp4',
          'video/quicktime'
        ];
    }


    function isAdmin() {
      return isSignedIn()
        && exists(/databases/(default)/documents/users/$(request.auth.uid))
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isTeacherOrAdmin() {
      return isSignedIn()
        && exists(/databases/(default)/documents/users/$(request.auth.uid))
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin', 'super_admin']
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isSafeAssignmentUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10485760
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isSafeImageUpload(5242880);
    }

    match /status_updates/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isSafeStatusUpload();
    }


    match /chat_media/{chatId}/{userId}/{fileName} {
      allow read: if canReadChatMedia(chatId);
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && fileName.matches('^[A-Za-z0-9._-]{6,160}$')
        && canReadChatMedia(chatId)
        && isSafeChatMediaUpload();
    }

    match /course_materials/{courseId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin()
        && fileName.matches('^[A-Za-z0-9._-]{6,160}$')
        && isSafeCourseMaterialUpload();
    }

    match /audio_lessons/{courseId}/{teacherId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin()
        && request.auth.uid == teacherId
        && fileName.matches('^[A-Za-z0-9._-]{6,180}$')
        && isSafeAudioLessonUpload();
      allow delete: if isAdmin() || (isTeacherOrAdmin() && request.auth.uid == teacherId);
    }


    match /live_classes/{classId}/{allPaths=**} {
      allow read: if canReadLiveClassStorage(classId);
      allow write: if false;
    }

    match /assignment_submissions/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacherOrAdmin());
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && fileName.matches('^[A-Za-z0-9._-]{6,140}$')
        && isSafeAssignmentUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
