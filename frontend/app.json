{
  "expo": {
    "name": "Madars tus salikat Lilbanat - \u0645\u062f\u0631\u0633\u06c3 \u0627\u0644\u0633\u0627\u0644\u06a9\u0627\u062a \u0644\u0644\u0628\u0646\u0627\u062a",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "madars-tus-salikat-lilbanat",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#000000"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access for profile photos, status media, live classes, and the native Camera Qibla Finder overlay.",
        "NSMicrophoneUsageDescription": "Allow microphone access for video status content and built-in live classes.",
        "NSLocationWhenInUseUsageDescription": "Allow location access to show accurate local prayer times, city details, and Qibla direction.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow location access to keep prayer times accurate while using the app.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.madrasatussalikat.lilbanat",
      "versionCode": 9,
      "notification": {
        "icon": "./assets/images/notification-icon.png",
        "color": "#0FA958"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your gallery",
          "cameraPermission": "Allow camera access to capture profile photos and status media.",
          "microphonePermission": "Allow microphone access when recording video."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0FA958"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9d9d5aa-0fc1-4368-a6ca-4186b1c6e28e"
      }
    },
    "owner": "msdl"
  }
}