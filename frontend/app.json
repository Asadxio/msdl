{
  "expo": {
    "name": "Suffah: Digital Madrasa - صُفَّة",
    "slug": "frontend",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "madars-tus-salikat-lilbanat",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "androidStatusBar": {
      "backgroundColor": "#F7F2E9",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow microphone access for interactive live audio classes and Quranic recitation.",
        "NSLocationWhenInUseUsageDescription": "Allow location access to show accurate local prayer times, city details, and Qibla direction.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow location access to keep prayer times accurate while using the app.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F4EA"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.madrasatussalikat.lilbanat",
      "versionCode": 51,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC4L8fnfXisqAzeEH0snYuxncP-gHMU6yA"
        }
      },
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "madars-tus-salikat-lilbanat"
            },
            {
              "scheme": "https",
              "host": "madrasa-app-50d6c.firebaseapp.com",
              "pathPrefix": "/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0B5D4B"
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ],
    "updates": {
      "url": "https://u.expo.dev/408ebb1a-6a8c-467e-b941-44b658fe7977",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 1500
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "408ebb1a-6a8c-467e-b941-44b658fe7977"
      }
    },
    "owner": "sumraftm"
  }
}
