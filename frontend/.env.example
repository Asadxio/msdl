# App release environment: development, staging, or production
EXPO_PUBLIC_APP_ENV=production

# Main backend API base URL. Include either the origin or /api suffix; the app normalizes both.
EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com/api

# Firebase project identifier expected by release checks.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# Live classes backend base URL (optional if API_BASE_URL is set).
EXPO_PUBLIC_LIVE_API_URL=https://your-backend.example.com

# Push API base URL (optional if API_BASE_URL is set).
EXPO_PUBLIC_PUSH_API_URL=https://your-backend.example.com


