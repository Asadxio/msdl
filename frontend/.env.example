# App release environment: development, staging, or production
EXPO_PUBLIC_APP_ENV=development

# Main backend API base URL. Include either the origin or /api suffix; the app normalizes both.
EXPO_PUBLIC_API_BASE_URL=https://msdl-production-9afb.up.railway.app/api

# Firebase project identifier expected by release checks.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=madrasa-app-50d6c

# Live classes backend base URL (required for Agora token/join/recording API)
# Local development example:
# EXPO_PUBLIC_LIVE_API_URL=http://192.168.1.20:8000
# Production example:
# EXPO_PUBLIC_LIVE_API_URL=https://api.yourdomain.com
EXPO_PUBLIC_LIVE_API_URL=https://msdl-production-9afb.up.railway.app

# Push API base URL (can be same backend)
EXPO_PUBLIC_PUSH_API_URL=https://msdl-production-9afb.up.railway.app

# Agora App ID used by mobile SDK
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id
