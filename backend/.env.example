# Core backend runtime
MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
DB_NAME=appdb

# CORS (comma-separated)
# Railway production example:
# CORS_ALLOW_ORIGINS=https://your-frontend-domain.com,https://your-app-domain.com
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type

# Firebase Admin credentials (use ONE of the two methods)
# 1) JSON string (recommended on Railway)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 2) Path-based credentials (non-Railway/local)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Agora (required for live class token APIs)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_RTC_TOKEN_TTL_SECONDS=900

# Agora cloud recording (required for recording start/stop APIs)
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret
AGORA_RECORDING_UID_BASE=1900000000
AGORA_RECORDING_VENDOR=1
AGORA_RECORDING_REGION=0
AGORA_RECORDING_BUCKET=your_bucket_name
AGORA_RECORDING_ACCESS_KEY=your_bucket_access_key
AGORA_RECORDING_SECRET_KEY=your_bucket_secret_key
