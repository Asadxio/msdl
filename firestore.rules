rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }


    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) ? userDoc(uid).role : 'student';
    }

    function isSuperAdmin() {
      return isSignedIn() && roleOf(request.auth.uid) == 'super_admin' && userDoc(request.auth.uid).status == 'approved';
    }

    function hasRole(uid, roles) {
      return exists(/databases/$(database)/documents/users/$(uid)) && roleOf(uid) in roles;
    }

    function isModerator() {
      return isSignedIn() && hasRole(request.auth.uid, ['moderator', 'admin', 'super_admin']) && userDoc(request.auth.uid).status == 'approved';
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) in ['admin', 'super_admin']
        && userDoc(request.auth.uid).status == 'approved';
    }

    function isTeacherOrAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) in ['teacher', 'assistant_teacher', 'admin', 'super_admin', 'moderator']
        && userDoc(request.auth.uid).status == 'approved';
    }



    function isModeratorOrAbove() {
      return isModerator();
    }

    function isStudent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) == 'student'
        && userDoc(request.auth.uid).status == 'approved';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnlyAllowedKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function isBlankOrHttpsUrl(value) {
      return value == null || value == '' || (value is string && value.matches('^https://.*$'));
    }

    function isValidUserCreate(uid) {
      return isSelf(uid)
        && hasOnlyAllowedKeys(
          request.resource.data,
          ['name', 'email', 'role', 'status', 'created_at', 'referral_code', 'referred_by', 'referral_count', 'last_login_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at is timestamp
        && (!('referral_code' in request.resource.data) || request.resource.data.referral_code is string)
        && (!('referred_by' in request.resource.data) || request.resource.data.referred_by == null || request.resource.data.referred_by is string)
        && (!('referral_count' in request.resource.data) || request.resource.data.referral_count is number)
        && (!('last_login_at' in request.resource.data) || request.resource.data.last_login_at is timestamp)
        && (request.auth.uid != resource.id || request.resource.data.role == resource.data.role)
        && ((request.resource.data.role in ['admin', 'super_admin']) ? isSuperAdmin() : true)
        && ((request.resource.data.role == 'assistant_teacher') ? roleOf(request.auth.uid) in ['admin', 'super_admin'] : true);
    }

    function isValidUserUpdateByAdmin() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['name', 'email', 'role', 'status', 'created_at', 'updated_at', 'fcm_tokens', 'expo_push_tokens', 'fcm_token_updated_at', 'photo_url', 'avatar', 'referral_code', 'referred_by', 'referral_count', 'last_login_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.role in ['student', 'teacher', 'assistant_teacher', 'moderator', 'admin', 'super_admin']
        && request.resource.data.status in ['pending', 'approved', 'deactivated', 'rejected']
        && (!('photo_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.photo_url))
        && (!('avatar' in request.resource.data) || request.resource.data.avatar is string)
        && (!('referral_code' in request.resource.data) || request.resource.data.referral_code is string)
        && (!('referred_by' in request.resource.data) || request.resource.data.referred_by == null || request.resource.data.referred_by is string)
        && (!('referral_count' in request.resource.data) || request.resource.data.referral_count is number)
        && (!('last_login_at' in request.resource.data) || request.resource.data.last_login_at is timestamp)
        && (request.auth.uid != resource.id || request.resource.data.role == resource.data.role)
        && ((request.resource.data.role in ['admin', 'super_admin']) ? isSuperAdmin() : true)
        && ((request.resource.data.role == 'assistant_teacher') ? isAdmin() : true);
    }

    function isValidSelfUserMetadataUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcm_tokens', 'expo_push_tokens', 'fcm_token_updated_at', 'photo_url', 'avatar', 'last_login_at'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.created_at == resource.data.created_at
        && (!('updated_at' in resource.data) || !('updated_at' in request.resource.data) || request.resource.data.updated_at == resource.data.updated_at)
        && (!('referral_code' in resource.data) || request.resource.data.referral_code == resource.data.referral_code)
        && (!('referred_by' in resource.data) || request.resource.data.referred_by == resource.data.referred_by)
        && (!('referral_count' in resource.data) || request.resource.data.referral_count == resource.data.referral_count)
        && (!('fcm_tokens' in request.resource.data) || (request.resource.data.fcm_tokens is list && request.resource.data.fcm_tokens.size() <= 10))
        && (!('expo_push_tokens' in request.resource.data) || (request.resource.data.expo_push_tokens is list && request.resource.data.expo_push_tokens.size() <= 10))
        && (!('fcm_token_updated_at' in request.resource.data) || request.resource.data.fcm_token_updated_at is timestamp)
        && (!('photo_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.photo_url))
        && (!('avatar' in request.resource.data) || request.resource.data.avatar is string)
        && (!('last_login_at' in request.resource.data) || request.resource.data.last_login_at is timestamp)
        && (request.auth.uid != resource.id || request.resource.data.role == resource.data.role)
        && ((request.resource.data.role in ['admin', 'super_admin']) ? isSuperAdmin() : true)
        && ((request.resource.data.role == 'assistant_teacher') ? isAdmin() : true);
    }

    function isValidReferralCountIncrement() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referral_count', 'updated_at'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.created_at == resource.data.created_at
        && (!('referral_code' in resource.data) || request.resource.data.referral_code == resource.data.referral_code)
        && (!('referred_by' in resource.data) || request.resource.data.referred_by == resource.data.referred_by)
        && request.resource.data.referral_count == resource.data.referral_count + 1
        && request.resource.data.updated_at is timestamp;
    }

    function isValidCourseWrite() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['name', 'teacher_name', 'teacherName', 'schedule', 'time', 'class_time', 'description', 'class_link', 'classLink', 'meet_link', 'created_at', 'updated_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (!('teacher_name' in request.resource.data) || request.resource.data.teacher_name is string)
        && (!('teacherName' in request.resource.data) || request.resource.data.teacherName is string)
        && (!('schedule' in request.resource.data) || request.resource.data.schedule is string)
        && (!('time' in request.resource.data) || request.resource.data.time is string)
        && (!('class_time' in request.resource.data) || request.resource.data.class_time is string)
        && (!('description' in request.resource.data) || request.resource.data.description is string)
        && (!('class_link' in request.resource.data) || request.resource.data.class_link is string)
        && (!('classLink' in request.resource.data) || request.resource.data.classLink is string)
        && (!('meet_link' in request.resource.data) || request.resource.data.meet_link is string);
    }

    function isValidTeacherWrite() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['name', 'title', 'courses', 'assigned_courses', 'photo_url', 'created_at', 'updated_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (!('title' in request.resource.data) || request.resource.data.title is string)
        && (!('courses' in request.resource.data) || request.resource.data.courses is list)
        && (!('assigned_courses' in request.resource.data) || request.resource.data.assigned_courses is list)
        && (!('photo_url' in request.resource.data) || request.resource.data.photo_url is string);
    }

    function isValidLibraryWrite() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['title', 'description', 'file_url', 'pdf_url', 'pdfUrl', 'category', 'category_id', 'deleted', 'deleted_at', 'created_at', 'updated_at']
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && (!('description' in request.resource.data) || request.resource.data.description is string)
        && (('file_url' in request.resource.data && request.resource.data.file_url is string)
            || ('pdf_url' in request.resource.data && request.resource.data.pdf_url is string)
            || ('pdfUrl' in request.resource.data && request.resource.data.pdfUrl is string))
        && (!('category' in request.resource.data) || request.resource.data.category is string)
        && (!('category_id' in request.resource.data) || request.resource.data.category_id is string)
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool)
        && (!('deleted_at' in request.resource.data) || request.resource.data.deleted_at is timestamp);
    }

    function isValidNotificationWrite() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['title', 'message', 'user_id', 'target_roles', 'target_user_ids', 'category', 'sound', 'read', 'created_at']
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.user_id is string
        && request.resource.data.user_id.size() > 0
        && (!('target_roles' in request.resource.data) || request.resource.data.target_roles is list)
        && (!('target_user_ids' in request.resource.data) || request.resource.data.target_user_ids is list)
        && (!('category' in request.resource.data) || request.resource.data.category is string)
        && (!('sound' in request.resource.data) || request.resource.data.sound == 'default')
        && (!('read' in request.resource.data) || request.resource.data.read is map)
        && request.resource.data.created_at is timestamp;
    }

    function isValidNotificationCreate() {
      return isValidNotificationWrite()
        && (
          isAdmin()
          || (isTeacherOrAdmin() && request.resource.data.user_id is string && request.resource.data.user_id != 'all')
          || (isSelf(request.resource.data.user_id))
          || (
            isSignedIn()
            && request.resource.data.user_id == 'role_targeted'
            && request.resource.data.category == 'assignment_submitted'
            && request.resource.data.target_roles is list
            && request.resource.data.target_roles.hasOnly(['teacher'])
          )
          || (
            isTeacherOrAdmin()
            && request.resource.data.user_id == 'role_targeted'
            && request.resource.data.category == 'live_class_started'
            && request.resource.data.target_roles is list
            && request.resource.data.target_roles.hasOnly(['student'])
          )
        );
    }

    function canReadNotification() {
      return isSignedIn()
        && (
          resource.data.user_id == 'all'
          || resource.data.user_id == request.auth.uid
          || (resource.data.user_id == 'role_targeted'
            && ((resource.data.target_user_ids is list && request.auth.uid in resource.data.target_user_ids)
              || (resource.data.target_roles is list
                && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in resource.data.target_roles)))
        );
    }

    function isValidNotificationReadUpdate() {
      return canReadNotification()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.title == resource.data.title
        && request.resource.data.message == resource.data.message
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.created_at == resource.data.created_at
        && (!('target_roles' in resource.data) || request.resource.data.target_roles == resource.data.target_roles)
        && (!('target_user_ids' in resource.data) || request.resource.data.target_user_ids == resource.data.target_user_ids)
        && (!('category' in resource.data) || request.resource.data.category == resource.data.category)
        && (!('sound' in resource.data) || request.resource.data.sound == resource.data.sound)
        && request.resource.data.read is map
        && request.resource.data.read[request.auth.uid] == true;
    }

    function isValidPaymentCreate() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['user_id', 'user_name', 'amount', 'payment_ref', 'status', 'provider', 'created_at', 'type', 'transaction_ref', 'review_mode', 'currency', 'submitted_at']
        )
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_name is string
        && request.resource.data.user_name.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.status in ['pending']
        && request.resource.data.provider == 'razorpay'
        && (!('type' in request.resource.data) || request.resource.data.type in ['fees', 'sadqa', 'zakat', 'fitra', 'langar'])
        && (!('transaction_ref' in request.resource.data) || (request.resource.data.transaction_ref is string && request.resource.data.transaction_ref.size() >= 4 && request.resource.data.transaction_ref.size() <= 80 && request.resource.data.transaction_ref.matches('^[a-zA-Z0-9_./# -]+$')))
        && request.resource.data.review_mode == 'manual'
        && request.resource.data.currency == 'INR'
        && (!('submitted_at' in request.resource.data) || request.resource.data.submitted_at is timestamp)
        && request.resource.data.created_at is timestamp;
    }

    function isValidPaymentUpdateByOwner() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment_ref', 'transaction_ref', 'status', 'submitted_at'])
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user_name == resource.data.user_name
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.type == resource.data.type
        && request.resource.data.review_mode == resource.data.review_mode
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.created_at == resource.data.created_at
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && (!('payment_ref' in request.resource.data) || request.resource.data.payment_ref == null || request.resource.data.payment_ref is string)
        && (!('transaction_ref' in request.resource.data) || request.resource.data.transaction_ref == null || request.resource.data.transaction_ref is string)
        && (!('submitted_at' in request.resource.data) || request.resource.data.submitted_at is timestamp);
    }

    function isValidPaymentUpdateByAdmin() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['user_id', 'user_name', 'amount', 'payment_ref', 'status', 'provider', 'created_at', 'submitted_at', 'type', 'transaction_ref', 'reviewed_at', 'review_mode', 'currency']
        )
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user_name == resource.data.user_name
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.review_mode == resource.data.review_mode
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.status in ['pending', 'submitted', 'verified', 'approved', 'rejected', 'processing', 'succeeded', 'failed', 'cancelled', 'refunded', 'disputed', 'expired']
        && (!('type' in request.resource.data) || request.resource.data.type in ['fees', 'sadqa', 'zakat', 'fitra', 'langar'])
        && (!('payment_ref' in request.resource.data) || request.resource.data.payment_ref == null || request.resource.data.payment_ref is string)
        && (!('transaction_ref' in request.resource.data) || request.resource.data.transaction_ref == null || request.resource.data.transaction_ref is string)
        && (!('submitted_at' in request.resource.data) || request.resource.data.submitted_at is timestamp)
        && (!('reviewed_at' in request.resource.data) || request.resource.data.reviewed_at is timestamp);
    }

    function isValidFeedbackCreate() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['user_id', 'user_name', 'message', 'rating', 'created_at']
        )
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_name is string
        && request.resource.data.user_name.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && (!('rating' in request.resource.data) || request.resource.data.rating == null || (request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && request.resource.data.created_at is timestamp;
    }

    function isChatParticipant() {
      return isSignedIn() && request.auth.uid in resource.data.participants;
    }

    function isChatParticipantByData() {
      return isSignedIn() && request.auth.uid in request.resource.data.participants;
    }

    function isBroadcastChat() {
      return resource.data.type == 'broadcast';
    }

    function isValidChatCreate() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['type', 'name', 'participants', 'participant_names', 'last_message', 'created_by', 'created_at', 'updated_at', 'typing', 'unread_counts', 'pinned_by', 'hidden_by', 'muted_by', 'blocked_pairs']
        )
        && request.resource.data.type in ['direct', 'group', 'broadcast']
        && request.resource.data.created_by is string
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.created_at is timestamp
        && request.resource.data.updated_at is timestamp
        && request.resource.data.participants is list
        && request.resource.data.participants.size() <= 200
        && (!('pinned_by' in request.resource.data) || request.resource.data.pinned_by is list)
        && (!('hidden_by' in request.resource.data) || request.resource.data.hidden_by is list)
        && (!('muted_by' in request.resource.data) || request.resource.data.muted_by is list)
        && (!('blocked_pairs' in request.resource.data) || request.resource.data.blocked_pairs is list)
        && (
          (request.resource.data.type == 'direct'
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants.size() == 2)
          || ((request.resource.data.type == 'group' || request.resource.data.type == 'broadcast') && isAdmin())
        );
    }

    function isValidChatBaseUnchanged() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['type', 'name', 'participants', 'participant_names', 'last_message', 'created_by', 'created_at', 'updated_at', 'typing', 'unread_counts', 'pinned_by', 'hidden_by', 'muted_by', 'blocked_pairs']
        )
        && request.resource.data.type in ['direct', 'group', 'broadcast']
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.created_at == resource.data.created_at
        && (isAdmin() || request.resource.data.participants == resource.data.participants);
    }

    function isValidChatUpdate() {
      return isValidChatBaseUnchanged()
        && (
          isAdmin()
          || (
            request.resource.data.type != 'broadcast'
            && isChatParticipant()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_message', 'updated_at', 'typing', 'unread_counts', 'pinned_by', 'hidden_by', 'muted_by', 'blocked_pairs'])
          )
          || (
            request.resource.data.type == 'broadcast'
            && isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned_by', 'hidden_by', 'muted_by'])
          )
        );
    }

    function canReadChat() {
      return isSignedIn() && (isBroadcastChat() || isChatParticipant());
    }

    function canWriteMessageToChat(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && !(
          ('blocked_pairs' in get(/databases/$(database)/documents/chats/$(chatId)).data)
          && (
            (request.auth.uid + ':' + get(/databases/$(database)/documents/chats/$(chatId)).data.created_by) in get(/databases/$(database)/documents/chats/$(chatId)).data.blocked_pairs
            || (get(/databases/$(database)/documents/chats/$(chatId)).data.created_by + ':' + request.auth.uid) in get(/databases/$(database)/documents/chats/$(chatId)).data.blocked_pairs
          )
        )
        && (
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'broadcast'
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )
          || (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'broadcast'
            && isAdmin()
          )
        );
    }

    function canReadMessage() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(resource.data.chat_id))
        && (
          get(/databases/$(database)/documents/chats/$(resource.data.chat_id)).data.type == 'broadcast'
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chat_id)).data.participants
        );
    }

    function hasValidMessageKeys(data) {
      return hasOnlyAllowedKeys(data, ['chat_id', 'text', 'sender_id', 'sender_name', 'created_at', 'read_by', 'client_id', 'deleted_for', 'deleted_for_everyone', 'unsent_by', 'unsent_at', 'message_type', 'media_url', 'media_name', 'media_size', 'status', 'sent_at', 'delivered_at', 'seen_at', 'failed_reason', 'retry_count', 'push_dedupe_id']);
    }

    function isValidMessageCreate() {
      return canWriteMessageToChat(request.resource.data.chat_id)
        && hasValidMessageKeys(request.resource.data)
        && request.resource.data.text is string
        && (request.resource.data.text.size() > 0 || (('media_url' in request.resource.data) && request.resource.data.media_url is string && request.resource.data.media_url.size() > 0))
        && request.resource.data.sender_id == request.auth.uid
        && request.resource.data.created_at is timestamp
        && request.resource.data.read_by is list
        && request.auth.uid in request.resource.data.read_by
        && (!('client_id' in request.resource.data) || request.resource.data.client_id is string)
        && (!('deleted_for' in request.resource.data) || request.resource.data.deleted_for is list)
        && (!('deleted_for_everyone' in request.resource.data) || request.resource.data.deleted_for_everyone is bool)
        && (!('message_type' in request.resource.data) || request.resource.data.message_type in ['text', 'image', 'video', 'audio'])
        && (!('media_url' in request.resource.data) || request.resource.data.media_url is string)
        && (!('media_name' in request.resource.data) || request.resource.data.media_name is string)
        && (!('media_size' in request.resource.data) || request.resource.data.media_size is number)
        && (!('status' in request.resource.data) || request.resource.data.status in ['sending', 'sent', 'delivered', 'seen', 'failed', 'retrying'])
        && (!('sent_at' in request.resource.data) || request.resource.data.sent_at is timestamp)
        && (!('delivered_at' in request.resource.data) || request.resource.data.delivered_at == null || request.resource.data.delivered_at is timestamp)
        && (!('seen_at' in request.resource.data) || request.resource.data.seen_at == null || request.resource.data.seen_at is timestamp)
        && (!('failed_reason' in request.resource.data) || request.resource.data.failed_reason is string)
        && (!('retry_count' in request.resource.data) || request.resource.data.retry_count is number)
        && (!('push_dedupe_id' in request.resource.data) || request.resource.data.push_dedupe_id is string);
    }

    function isValidMessageUpdate() {
      return canReadMessage()
        && hasValidMessageKeys(request.resource.data)
        && request.resource.data.chat_id == resource.data.chat_id
        && request.resource.data.sender_id == resource.data.sender_id
        && request.resource.data.sender_name == resource.data.sender_name
        && request.resource.data.created_at == resource.data.created_at
        && (!('client_id' in resource.data) || request.resource.data.client_id == resource.data.client_id)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by'])
            && request.resource.data.text == resource.data.text
            && request.resource.data.read_by is list
            && request.auth.uid in request.resource.data.read_by
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'delivered_at', 'seen_at', 'read_by'])
            && request.resource.data.status in ['delivered', 'seen']
            && request.resource.data.read_by is list
            && request.auth.uid in request.resource.data.read_by
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted_for'])
            && request.resource.data.text == resource.data.text
            && request.resource.data.deleted_for is list
            && request.auth.uid in request.resource.data.deleted_for
          )
          || (
            request.auth.uid == resource.data.sender_id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted_for_everyone', 'unsent_by', 'unsent_at'])
            && request.resource.data.text == 'This message was unsent.'
            && request.resource.data.deleted_for_everyone == true
            && request.resource.data.unsent_by == request.auth.uid
            && request.resource.data.unsent_at is timestamp
          )
        );
    }

    function isValidStatusCreate() {
      return isTeacherOrAdmin()
        && hasOnlyAllowedKeys(request.resource.data, ['user_id', 'user_name', 'role', 'text', 'media_url', 'media_type', 'likes', 'comments', 'created_at', 'audience', 'audience_user_ids', 'hidden_user_ids', 'muted_by', 'reaction_counts', 'expires_at_ms'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_name is string
        && request.resource.data.role in ['teacher', 'admin']
        && request.resource.data.text is string
        && (!('media_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.media_url))
        && (!('media_type' in request.resource.data) || request.resource.data.media_type in ['', 'image', 'video'])
        && request.resource.data.likes is list
        && request.resource.data.comments is list
        && (!('audience' in request.resource.data) || request.resource.data.audience in ['everyone', 'teachers', 'students', 'custom'])
        && (!('audience_user_ids' in request.resource.data) || request.resource.data.audience_user_ids is list)
        && (!('hidden_user_ids' in request.resource.data) || request.resource.data.hidden_user_ids is list)
        && (!('muted_by' in request.resource.data) || request.resource.data.muted_by is list)
        && (!('reaction_counts' in request.resource.data) || request.resource.data.reaction_counts is map)
        && (!('expires_at_ms' in request.resource.data) || request.resource.data.expires_at_ms is number)
        && request.resource.data.created_at is timestamp;
    }

    function isValidStatusInteractionUpdate() {
      return isStudent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'hidden_user_ids', 'muted_by', 'reaction_counts'])
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user_name == resource.data.user_name
        && request.resource.data.role == resource.data.role
        && request.resource.data.text == resource.data.text
        && request.resource.data.media_url == resource.data.media_url
        && request.resource.data.media_type == resource.data.media_type
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.likes is list
        && request.resource.data.comments is list
        && (!('hidden_user_ids' in request.resource.data) || request.auth.uid in request.resource.data.hidden_user_ids)
        && (!('muted_by' in request.resource.data) || request.auth.uid in request.resource.data.muted_by);
    }


    function isValidAttendanceRecord() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['user_id', 'user_name', 'user_email', 'date', 'status', 'marked_by', 'marked_by_uid', 'marked_by_name', 'created_at', 'marked_at', 'updated_at', 'live_class_id', 'course_id', 'duration_seconds']
        )
        && isTeacherOrAdmin()
        && request.resource.data.user_id is string
        && request.resource.data.user_id.size() > 0
        && exists(/databases/$(database)/documents/users/$(request.resource.data.user_id))
        && get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.status == 'approved'
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status in ['present', 'absent']
        && request.resource.data.marked_by in ['teacher', 'admin', 'live_class']
        && request.resource.data.marked_by_uid == request.auth.uid
        && request.resource.data.marked_by_name is string
        && (!('user_name' in request.resource.data) || request.resource.data.user_name is string)
        && (!('user_email' in request.resource.data) || request.resource.data.user_email is string)
        && request.resource.data.marked_at is timestamp
        && request.resource.data.updated_at is timestamp
        && (!('live_class_id' in request.resource.data) || request.resource.data.live_class_id is string)
        && (!('course_id' in request.resource.data) || request.resource.data.course_id is string)
        && (!('duration_seconds' in request.resource.data) || (request.resource.data.duration_seconds is number && request.resource.data.duration_seconds >= 0 && request.resource.data.duration_seconds <= 43200))
        && (!('created_at' in request.resource.data) || request.resource.data.created_at is timestamp);
    }

    function isAttendanceRecordUnchangedOwner() {
      return resource.data.user_id == request.resource.data.user_id
        && resource.data.date == request.resource.data.date
        && (!('created_at' in resource.data) || request.resource.data.created_at == resource.data.created_at);
    }



    function liveClassDoc(classId) {
      return get(/databases/$(database)/documents/live_classes/$(classId));
    }

    function isLiveClassTeacherOrAdmin(data) {
      return isSignedIn()
        && (
          isAdmin()
          || (isTeacherOrAdmin() && data.teacher_id == request.auth.uid)
        );
    }

    function canJoinLiveClassData(data) {
      return isSignedIn()
        && data.status == 'live'
        && (
          isLiveClassTeacherOrAdmin(data)
          || (data.student_ids is list && request.auth.uid in data.student_ids)
        );
    }

    function canReadLiveClassData(data) {
      return isSignedIn()
        && (
          isLiveClassTeacherOrAdmin(data)
          || (data.student_ids is list && request.auth.uid in data.student_ids)
        );
    }

    function isValidLiveClassWrite() {
      return hasOnlyAllowedKeys(request.resource.data, [
          'course_id', 'lesson_id', 'teacher_id', 'teacher_name', 'title', 'status', 'channel_name',
          'agora_app_id', 'meet_fallback_url', 'student_ids', 'enrollment_source',
          'participant_count', 'recording', 'screen_share', 'started_at', 'ended_at', 'created_at', 'updated_at'
        ])
        && request.resource.data.course_id is string
        && request.resource.data.teacher_id is string
        && request.resource.data.title is string
        && request.resource.data.status in ['scheduled', 'live', 'ended', 'cancelled']
        && request.resource.data.channel_name is string
        && (!('lesson_id' in request.resource.data) || request.resource.data.lesson_id is string)
        && (!('student_ids' in request.resource.data) || (request.resource.data.student_ids is list && request.resource.data.student_ids.size() <= 500))
        && (!('participant_count' in request.resource.data) || request.resource.data.participant_count is number)
        && (!('started_at' in request.resource.data) || request.resource.data.started_at is timestamp)
        && (!('ended_at' in request.resource.data) || request.resource.data.ended_at is timestamp)
        && request.resource.data.updated_at is timestamp;
    }


    function canReadRecordingData(data) {
      return isSignedIn()
        && (
          !('live_class_id' in data)
          || data.live_class_id == ''
          || (data.live_class_id is string
            && exists(/databases/$(database)/documents/live_classes/$(data.live_class_id))
            && canReadLiveClassData(get(/databases/$(database)/documents/live_classes/$(data.live_class_id)).data))
        );
    }

    function isValidLiveParticipantWrite(classId, userId) {
      return hasOnlyAllowedKeys(request.resource.data, [
          'user_id', 'agora_uid', 'name', 'role', 'joined', 'audio_enabled', 'video_enabled',
          'force_muted', 'is_speaking', 'joined_at', 'last_joined_at', 'left_at', 'total_duration_seconds', 'updated_at'
        ])
        && request.resource.data.user_id == userId
        && request.resource.data.agora_uid is number
        && request.resource.data.name is string
        && request.resource.data.role in ['student', 'teacher', 'assistant_teacher', 'moderator', 'admin', 'super_admin']
        && request.resource.data.joined is bool
        && request.resource.data.audio_enabled is bool
        && request.resource.data.video_enabled is bool
        && (!('force_muted' in request.resource.data) || request.resource.data.force_muted is bool)
        && (!('is_speaking' in request.resource.data) || request.resource.data.is_speaking is bool)
        && (!('total_duration_seconds' in request.resource.data) || (request.resource.data.total_duration_seconds is number && request.resource.data.total_duration_seconds >= 0 && request.resource.data.total_duration_seconds <= 43200))
        && request.resource.data.updated_at is timestamp
        && canJoinLiveClassData(liveClassDoc(classId).data);
    }

    function isValidLiveParticipantModeration(classId) {
      return isLiveClassTeacherOrAdmin(liveClassDoc(classId).data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['force_muted', 'audio_enabled', 'updated_at'])
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.agora_uid == resource.data.agora_uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.role == resource.data.role
        && request.resource.data.joined == resource.data.joined
        && request.resource.data.video_enabled == resource.data.video_enabled
        && (!('total_duration_seconds' in resource.data) || request.resource.data.total_duration_seconds == resource.data.total_duration_seconds)
        && request.resource.data.force_muted is bool
        && request.resource.data.audio_enabled is bool
        && request.resource.data.updated_at is timestamp;
    }

    // users collection
    match /users/{uid} {
      // Users can read their own profile; signed-in users can list users for app pickers/referrals.
      allow get: if isAdmin() || isSelf(uid);
      allow list: if isAdmin() || isTeacherOrAdmin();

      // Self-signup profile creation.
      allow create: if isValidUserCreate(uid);

      // Admin can fully update users; users can update own push/profile/login metadata.
      allow update: if (isAdmin() && isValidUserUpdateByAdmin()) || isValidSelfUserMetadataUpdate(uid) || isValidReferralCountIncrement();
      allow delete: if isAdmin();
    }

    match /public_profiles/{uid} {
      allow get, list: if isSignedIn();
      allow create, update: if (isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role in ['student', 'teacher', 'assistant_teacher', 'moderator', 'admin', 'super_admin']
          && request.resource.data.status in ['approved', 'pending', 'deactivated', 'rejected']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.searchable is bool
          && request.resource.data.is_active is bool
          && (!('photo_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.photo_url))
          && (!('avatar' in request.resource.data) || request.resource.data.avatar is string)
          && (!('updated_at' in request.resource.data) || request.resource.data.updated_at is timestamp)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'status', 'searchable', 'is_active', 'photo_url', 'avatar', 'updated_at']))
        || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();
    }

    // courses collection
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidCourseWrite();
      allow delete: if isAdmin();
    }

    // teachers collection
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidTeacherWrite();
      allow delete: if isAdmin();
    }

    // library collection
    match /library/{bookId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidLibraryWrite();
      allow delete: if isAdmin();
    }

    // attendance collection
    match /attendance/{attendanceId} {
      allow read: if isTeacherOrAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isValidAttendanceRecord();
      allow update: if isValidAttendanceRecord() && isAttendanceRecordUnchangedOwner();
      allow delete: if isAdmin();
    }

    // notifications collection
    match /notifications/{notificationId} {
      // Signed-in users can read broadcast, own, and role-targeted notifications used by the app.
      allow read: if canReadNotification();

      // Admin can create/modify; teachers can create direct class notifications; users can create own local result notifications.
      allow create: if isValidNotificationCreate();
      allow update: if (isAdmin() && isValidNotificationWrite()) || isValidNotificationReadUpdate();
      allow delete: if isAdmin();
    }

    // chats collection
    match /chats/{chatId} {
      allow read: if canReadChat();
      allow create: if isSignedIn() && isValidChatCreate();
      allow update: if canReadChat() && isValidChatUpdate();
      allow delete: if isAdmin();
    }

    // messages collection
    match /messages/{messageId} {
      allow read: if canReadMessage();
      allow create: if isValidMessageCreate();
      allow update: if isValidMessageUpdate();
      allow delete: if false;
    }


    // status updates collection
    match /status_updates/{statusId} {
      allow read: if isSignedIn();
      allow create: if isValidStatusCreate();
      allow update: if isValidStatusInteractionUpdate();
      allow delete: if isAdmin() || (isTeacherOrAdmin() && resource.data.user_id == request.auth.uid);
    }

    match /status_updates/{statusId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['id', 'user_id', 'user_name', 'user_avatar', 'text', 'created_at', 'created_at_ms', 'edited_at', 'deleted'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.id == commentId
        && request.resource.data.text is string
        && request.resource.data.created_at_ms is number;
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_at_ms == resource.data.created_at_ms
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited_at', 'deleted']);
      allow delete: if false;
    }

    match /status_updates/{statusId}/reactions/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['reaction', 'user_id', 'updated_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.reaction in ['❤️', '🔥', '👏'];
      allow delete: if isSignedIn() && uid == request.auth.uid;
    }

    match /status_updates/{statusId}/views/{viewerId} {
      allow read: if isAdmin() || (isSignedIn() && (viewerId == request.auth.uid || get(/databases/$(database)/documents/status_updates/$(statusId)).data.user_id == request.auth.uid));
      allow create, update: if isSignedIn() && viewerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['user_id', 'viewed_at', 'viewed_at_ms'])
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    match /status_reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporter_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['reporter_id', 'status_id', 'owner_id', 'reason', 'created_at'])
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.status_id is string
        && request.resource.data.owner_id is string
        && request.resource.data.reason is string
        && request.resource.data.created_at is timestamp;
      allow update, delete: if isAdmin();
    }

    // Backward-compatible alias if a build writes chat_messages instead of messages.
    match /chat_messages/{messageId} {
      allow read: if canReadMessage();
      allow create: if isValidMessageCreate();
      allow update: if isValidMessageUpdate();
      allow delete: if false;
    }

    match /message_reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporter_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['reporter_id', 'target_user_id', 'target_message_id', 'reason', 'created_at'])
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.target_user_id is string
        && request.resource.data.target_message_id is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 2
        && request.resource.data.created_at is timestamp;
      allow update, delete: if isAdmin();
    }

    // payments collection
    match /payments/{paymentId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && isValidPaymentCreate();
      allow update: if (isAdmin() && isValidPaymentUpdateByAdmin())
        || (isSignedIn() && resource.data.user_id == request.auth.uid && isValidPaymentUpdateByOwner());
      allow delete: if isAdmin();
    }



    match /payment_gateway_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payment_processor_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payment_verification_queue/{queueId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // modules/lessons/assignments and related learning data
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /quiz_results/{resultId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.total_questions is number
        && request.resource.data.created_at is timestamp
        && request.resource.data.keys().hasOnly(['user_id', 'score', 'total_questions', 'created_at']);
      allow update, delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_name is string
        && request.resource.data.course_name is string
        && request.resource.data.completion_date is string
        && request.resource.data.created_at is timestamp
        && request.resource.data.keys().hasOnly(['user_id', 'user_name', 'course_name', 'completion_date', 'created_at']);
      allow update, delete: if isAdmin();
    }


    match /enrollments/{enrollmentId} {
      allow read: if isTeacherOrAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /lesson_progress/{progressId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create, update: if isAdmin()
        || (isSignedIn()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.lesson_id is string
          && request.resource.data.keys().hasOnly(['user_id', 'lesson_id', 'course_id', 'module_id', 'completed', 'quiz_completed', 'completed_at', 'last_opened_at', 'updated_at'])
          && (!('course_id' in request.resource.data) || request.resource.data.course_id is string)
          && (!('module_id' in request.resource.data) || request.resource.data.module_id is string)
          && (!('completed' in request.resource.data) || request.resource.data.completed is bool)
          && (!('quiz_completed' in request.resource.data) || request.resource.data.quiz_completed is bool)
          && (!('completed_at' in request.resource.data) || request.resource.data.completed_at is timestamp)
          && (!('last_opened_at' in request.resource.data) || request.resource.data.last_opened_at is timestamp)
          && (!('updated_at' in request.resource.data) || request.resource.data.updated_at is timestamp));
      allow delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isTeacherOrAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create, update: if isTeacherOrAdmin()
        || (isSignedIn()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.keys().hasOnly(['assignment_id', 'user_id', 'file_url', 'file_name', 'mime_type', 'text_answer', 'status', 'submitted_at', 'created_at', 'updated_at', 'reviewed_at', 'reviewed_by', 'reviewer_id', 'notes', 'feedback', 'grade'])
          && request.resource.data.assignment_id is string
          && (!('file_url' in request.resource.data) || request.resource.data.file_url is string)
          && (!('file_name' in request.resource.data) || request.resource.data.file_name is string)
          && (!('mime_type' in request.resource.data) || request.resource.data.mime_type is string)
          && (!('text_answer' in request.resource.data) || request.resource.data.text_answer is string)
          && request.resource.data.status in ['submitted', 'reviewed']
          && (!('submitted_at' in request.resource.data) || request.resource.data.submitted_at is timestamp)
          && (!('created_at' in request.resource.data) || request.resource.data.created_at is timestamp)
          && (!('updated_at' in request.resource.data) || request.resource.data.updated_at is timestamp));
      allow delete: if isAdmin();
    }

    match /learning_state/{stateId} {
      allow read: if isAdmin() || isSelf(stateId);
      allow create, update: if isAdmin() || isSelf(stateId);
      allow delete: if isAdmin();
    }

    match /recordings/{recordingId} {
      allow read: if canReadRecordingData(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /live_classes/{classId} {
      allow read: if canReadLiveClassData(resource.data);
      allow create: if isTeacherOrAdmin()
        && isValidLiveClassWrite()
        && (isAdmin() || request.resource.data.teacher_id == request.auth.uid)
        && request.resource.data.status == 'live';
      allow update: if isLiveClassTeacherOrAdmin(resource.data)
        && isValidLiveClassWrite()
        && request.resource.data.teacher_id == resource.data.teacher_id
        && request.resource.data.course_id == resource.data.course_id
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isAdmin();

      match /participants/{userId} {
        allow read: if canReadLiveClassData(liveClassDoc(classId).data);
        allow create: if isSignedIn() && request.auth.uid == userId && isValidLiveParticipantWrite(classId, userId);
        allow update: if isValidLiveParticipantModeration(classId) || (isSignedIn() && request.auth.uid == userId && isValidLiveParticipantWrite(classId, userId));
        allow delete: if isAdmin();
      }

      match /attendance_events/{eventId} {
        allow read: if isTeacherOrAdmin();
        allow create: if isSignedIn()
          && hasOnlyAllowedKeys(request.resource.data, ['user_id', 'event', 'duration_seconds', 'at'])
          && canJoinLiveClassData(liveClassDoc(classId).data)
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.event in ['join', 'leave']
          && (!('duration_seconds' in request.resource.data) || (request.resource.data.duration_seconds is number && request.resource.data.duration_seconds >= 0 && request.resource.data.duration_seconds <= 43200))
          && request.resource.data.at is timestamp;
        allow update, delete: if false;
      }

      match /recordings/{recordingId} {
        allow read: if canReadLiveClassData(liveClassDoc(classId).data);
        allow write: if isLiveClassTeacherOrAdmin(liveClassDoc(classId).data);
      }
    }

    // feedback collection
    match /feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidFeedbackCreate();
      allow update, delete: if isAdmin();
    }

    // editable app settings (fees/social links)
    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }



    match /security_events_immutable/{id} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }
    // Deny all other document access by default.
    match /{document=**} {
      allow read, write: if false;
    }

    match /moderation_reports/{id} {
      allow read: if isModeratorOrAbove() || (isSignedIn() && resource.data.reporter_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.state == 'pending'
        && request.resource.data.severity in ['low','medium','high','critical']
        && request.resource.data.created_at is timestamp
        && request.resource.data.created_at_ms is number;
      allow update: if isModeratorOrAbove()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','reviewed_at','reviewed_by','moderation_notes','priority','actioned_at','actioned_by','actioned_at_ms'])
        && !(resource.data.accused_role in ['admin','super_admin'] && roleOf(request.auth.uid) == 'moderator');
      allow delete: if false;
    }

    match /moderation_evidence/{id} {
      allow read: if isModeratorOrAbove();
      allow create: if isSignedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /moderation_actions/{id} {
      allow read: if isModeratorOrAbove();
      allow create: if isModeratorOrAbove()
        && request.resource.data.actor_uid == request.auth.uid
        && request.resource.data.created_at is timestamp
        && !(request.resource.data.target_role in ['admin','super_admin'] && roleOf(request.auth.uid) == 'moderator');
      allow update, delete: if false;
    }

    match /moderation_analytics_daily/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
