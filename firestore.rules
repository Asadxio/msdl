rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return (isSignedIn()
        && (
          request.auth.token.email_verified == true
          // Allow all approved users (admin-verified institutional roster)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved')
        ));
    }

    function isApprovedVerifiedUser() {
      return (isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).status == 'approved');
    }


    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) ? userDoc(uid).role : 'student';
    }

    function isSuperAdmin() {
      return (isVerified() && roleOf(request.auth.uid) == 'super_admin' && userDoc(request.auth.uid).status == 'approved');
    }

    function hasRole(uid, roles) {
      return exists(/databases/$(database)/documents/users/$(uid)) && roleOf(uid) in roles;
    }

    function isModerator() {
      return (isVerified() && hasRole(request.auth.uid, ['moderator', 'admin', 'super_admin']) && userDoc(request.auth.uid).status == 'approved');
    }

    function isAdmin() {
      return (isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) in ['admin', 'super_admin']
        && userDoc(request.auth.uid).status == 'approved');
    }

    function isTeacherOrAdmin() {
      return (isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) in ['teacher', 'assistant_teacher', 'admin', 'super_admin', 'moderator']
        && userDoc(request.auth.uid).status == 'approved');
    }



    function isModeratorOrAbove() {
      return isModerator();
    }


    function isApprovedTeacher() {
      return isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) == 'teacher'
        && userDoc(request.auth.uid).status == 'approved';
    }

    function isStudent() {
      return isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) == 'student'
        && userDoc(request.auth.uid).status == 'approved';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnlyAllowedKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function isBlankOrHttpsUrl(value) {
      return value == null || value == '' || (value is string && value.matches('^https://.*$'));
    }


    function isValidProfileAboutSettings(data) {
      return !data.keys().hasAny(['profile'])
        || (
          data.profile is map
          && data.profile.keys().hasOnly(['about_madrasa'])
          && (!data.profile.keys().hasAny(['about_madrasa']) || data.profile.about_madrasa is string)
        );
    }

    function appSettingsChangedKeys(docId) {
      return exists(/databases/$(database)/documents/app_settings/$(docId))
        ? request.resource.data.diff(resource.data).affectedKeys()
        : request.resource.data.keys();
    }

    function isValidPlatformSettingsWrite(docId) {
      return appSettingsChangedKeys(docId).hasOnly(
          [
            'fees_amount',
            'razorpay_link',
            'whatsapp_channel',
            'whatsapp_contact',
            'instagram',
            'youtube_link',
            'telegram_link',
            'youtube_telegram',
            'donation_content',
            'notice_title',
            'notice_message',
            'hadith_text',
            'hadith_ref',
            'profile',
            'updated_at'
          ]
        )
        && !appSettingsChangedKeys(docId).hasAny(['about', 'about_content', 'introduction_content'])
        && isValidProfileAboutSettings(request.resource.data);
    }

    function isValidUserCreate(uid) {
      return isSelf(uid)
        && hasOnlyAllowedKeys(
          request.resource.data,
          ['name', 'email', 'role', 'status', 'created_at', 'referral_code', 'referred_by', 'referral_count', 'last_login_at', 'is_minor', 'age_bracket', 'guardian_name', 'guardian_phone']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at is timestamp
        && (!('referral_code' in request.resource.data) || request.resource.data.referral_code is string)
        && (!('referred_by' in request.resource.data) || request.resource.data.referred_by == null || request.resource.data.referred_by is string)
        && (!('referral_count' in request.resource.data) || request.resource.data.referral_count is number)
        && (!('last_login_at' in request.resource.data) || request.resource.data.last_login_at is timestamp)
        && (!('is_minor' in request.resource.data) || request.resource.data.is_minor is bool)
        && (!('age_bracket' in request.resource.data) || request.resource.data.age_bracket is string)
        && (!('guardian_name' in request.resource.data) || request.resource.data.guardian_name is string)
        && (!('guardian_phone' in request.resource.data) || request.resource.data.guardian_phone is string)
        && ((request.resource.data.role in ['admin', 'super_admin']) ? isSuperAdmin() : true)
        && ((request.resource.data.role == 'assistant_teacher') ? roleOf(request.auth.uid) in ['admin', 'super_admin'] : true);
    }

    function isValidUserUpdateByAdmin() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['name', 'email', 'role', 'status', 'created_at', 'updated_at', 'fcm_tokens', 'expo_push_tokens', 'fcm_token_updated_at', 'photo_url', 'avatar', 'referral_code', 'referred_by', 'referral_count', 'last_login_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.role in ['student', 'teacher', 'assistant_teacher', 'moderator', 'admin', 'super_admin']
        && request.resource.data.status in ['pending', 'approved', 'deactivated', 'rejected']
        && (!('photo_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.photo_url))
        && (!('avatar' in request.resource.data) || request.resource.data.avatar is string)
        && (!('referral_code' in request.resource.data) || request.resource.data.referral_code is string)
        && (!('referred_by' in request.resource.data) || request.resource.data.referred_by == null || request.resource.data.referred_by is string)
        && (!('referral_count' in request.resource.data) || request.resource.data.referral_count is number)
        && (!('last_login_at' in request.resource.data) || request.resource.data.last_login_at is timestamp)
        && (request.auth.uid != resource.id || request.resource.data.role == resource.data.role)
        && ((request.resource.data.role in ['admin', 'super_admin']) ? isSuperAdmin() : true)
        && ((request.resource.data.role == 'assistant_teacher') ? isAdmin() : true)
    && (!resource.data.get('founder', false) || isSuperAdmin());
    }

    function isValidSelfUserMetadataUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcm_tokens', 'expo_push_tokens', 'fcm_token_updated_at', 'photo_url', 'avatar', 'last_login_at'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.created_at == resource.data.created_at
        && (!('updated_at' in resource.data) || !('updated_at' in request.resource.data) || request.resource.data.updated_at == resource.data.updated_at)
        && (!('referral_code' in resource.data) || request.resource.data.referral_code == resource.data.referral_code)
        && (!('referred_by' in resource.data) || request.resource.data.referred_by == resource.data.referred_by)
        && (!('referral_count' in resource.data) || request.resource.data.referral_count == resource.data.referral_count)
        && (!('fcm_tokens' in request.resource.data) || (request.resource.data.fcm_tokens is list && request.resource.data.fcm_tokens.size() <= 10))
        && (!('expo_push_tokens' in request.resource.data) || (request.resource.data.expo_push_tokens is list && request.resource.data.expo_push_tokens.size() <= 10))
        && (!('fcm_token_updated_at' in request.resource.data) || request.resource.data.fcm_token_updated_at is timestamp)
        && (!('photo_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.photo_url))
        && (!('avatar' in request.resource.data) || request.resource.data.avatar is string)
        && (!('last_login_at' in request.resource.data) || request.resource.data.last_login_at is timestamp)
        && (request.auth.uid != resource.id || request.resource.data.role == resource.data.role)
        && ((request.resource.data.role in ['admin', 'super_admin']) ? isSuperAdmin() : true)
        && ((request.resource.data.role == 'assistant_teacher') ? isAdmin() : true);
    }

    function isValidReferralCountIncrement() {
      return isApprovedVerifiedUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referral_count', 'updated_at'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.created_at == resource.data.created_at
        && (!('referral_code' in resource.data) || request.resource.data.referral_code == resource.data.referral_code)
        && (!('referred_by' in resource.data) || request.resource.data.referred_by == resource.data.referred_by)
        && request.resource.data.referral_count == resource.data.referral_count + 1
        && request.resource.data.updated_at is timestamp;
    }

    function isValidCourseWrite() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['name', 'teacher_name', 'teacherName', 'teacher_id', 'schedule', 'time', 'class_time', 'description', 'class_link', 'classLink', 'meet_link', 'subjects', 'created_at', 'updated_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (!('teacher_name' in request.resource.data) || request.resource.data.teacher_name is string)
        && (!('teacherName' in request.resource.data) || request.resource.data.teacherName is string)
        && (!('teacher_id' in request.resource.data) || request.resource.data.teacher_id is string)
        && (!('schedule' in request.resource.data) || request.resource.data.schedule is string)
        && (!('time' in request.resource.data) || request.resource.data.time is string)
        && (!('class_time' in request.resource.data) || request.resource.data.class_time is string)
        && (!('description' in request.resource.data) || request.resource.data.description is string)
        && (!('class_link' in request.resource.data) || request.resource.data.class_link is string)
        && (!('classLink' in request.resource.data) || request.resource.data.classLink is string)
        && (!('meet_link' in request.resource.data) || request.resource.data.meet_link is string)
        && (!('subjects' in request.resource.data) || request.resource.data.subjects is list);
    }

    function isValidTeacherWrite() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['name', 'title', 'courses', 'assigned_courses', 'photo_url', 'bio', 'qualifications', 'specializations', 'experience_years', 'languages', 'created_at', 'updated_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (!('title' in request.resource.data) || request.resource.data.title is string)
        && (!('courses' in request.resource.data) || request.resource.data.courses is list)
        && (!('assigned_courses' in request.resource.data) || request.resource.data.assigned_courses is list)
        && (!('photo_url' in request.resource.data) || request.resource.data.photo_url is string)
        && (!('bio' in request.resource.data) || request.resource.data.bio is string)
        && (!('experience_years' in request.resource.data) || request.resource.data.experience_years is string || request.resource.data.experience_years is number)
        && (!('qualifications' in request.resource.data) || request.resource.data.qualifications is list || request.resource.data.qualifications is string)
        && (!('specializations' in request.resource.data) || request.resource.data.specializations is list || request.resource.data.specializations is string)
        && (!('languages' in request.resource.data) || request.resource.data.languages is list || request.resource.data.languages is string);
    }

    function isValidLibraryWrite() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['title', 'description', 'file_url', 'pdf_url', 'pdfUrl', 'category', 'category_id', 'deleted', 'deleted_at', 'created_at', 'updated_at']
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && (!('description' in request.resource.data) || request.resource.data.description is string)
        && (('file_url' in request.resource.data && request.resource.data.file_url is string)
            || ('pdf_url' in request.resource.data && request.resource.data.pdf_url is string)
            || ('pdfUrl' in request.resource.data && request.resource.data.pdfUrl is string))
        && (!('category' in request.resource.data) || request.resource.data.category is string)
        && (!('category_id' in request.resource.data) || request.resource.data.category_id is string)
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool)
        && (!('deleted_at' in request.resource.data) || request.resource.data.deleted_at is timestamp);
    }

    function isValidNotificationWrite() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          [
            'title', 'message', 'user_id', 'target_roles', 'target_user_ids',
            'category', 'sound', 'read', 'hidden_by', 'created_at',
            'data', 'dedupe_id', 'created_at_ms', 'recipient_id', 'actor_id',
            'channel', 'event', 'body', 'route'
          ]
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.user_id is string
        && request.resource.data.user_id.size() > 0
        && (!('target_roles' in request.resource.data) || request.resource.data.target_roles is list)
        && (!('target_user_ids' in request.resource.data) || request.resource.data.target_user_ids is list)
        && (!('category' in request.resource.data) || request.resource.data.category is string)
        && (!('sound' in request.resource.data) || request.resource.data.sound == 'default')
        && (!('read' in request.resource.data) || request.resource.data.read is map)
        && (!('hidden_by' in request.resource.data) || request.resource.data.hidden_by is list)
        && (!('data' in request.resource.data) || request.resource.data.data is map)
        && (!('dedupe_id' in request.resource.data) || request.resource.data.dedupe_id is string)
        && (!('created_at_ms' in request.resource.data) || request.resource.data.created_at_ms is number)
        && (!('recipient_id' in request.resource.data) || request.resource.data.recipient_id is string)
        && (!('actor_id' in request.resource.data) || request.resource.data.actor_id is string)
        && (!('channel' in request.resource.data) || request.resource.data.channel is string)
        && (!('event' in request.resource.data) || request.resource.data.event is string)
        && (!('body' in request.resource.data) || request.resource.data.body is string)
        && (!('route' in request.resource.data) || request.resource.data.route is string)
        && request.resource.data.created_at is timestamp;
    }

    function isValidNotificationCreate() {
      return isValidNotificationWrite()
        && (
          isAdmin()
          || (isTeacherOrAdmin() && request.resource.data.user_id is string && request.resource.data.user_id != 'all')
          || (isSelf(request.resource.data.user_id))
          || (
            isApprovedVerifiedUser()
            && request.resource.data.user_id == 'role_targeted'
            && request.resource.data.category == 'assignment_submitted'
            && request.resource.data.target_roles is list
            && request.resource.data.target_roles.hasOnly(['teacher'])
          )
          || (
            isTeacherOrAdmin()
            && request.resource.data.user_id == 'role_targeted'
            && request.resource.data.category == 'live_class_started'
            && request.resource.data.target_roles is list
            && request.resource.data.target_roles.hasOnly(['student'])
          )
        );
    }

    function canReadNotification() {
      return isApprovedVerifiedUser()
        && (
          resource.data.user_id == 'all'
          || resource.data.user_id == request.auth.uid
          || (resource.data.user_id == 'role_targeted'
            && ((resource.data.target_user_ids is list && request.auth.uid in resource.data.target_user_ids)
              || (resource.data.target_roles is list
                && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in resource.data.target_roles)))
        );
    }

    function isValidNotificationReadUpdate() {
      return canReadNotification()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'hidden_by'])
        && request.resource.data.title == resource.data.title
        && request.resource.data.message == resource.data.message
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.created_at == resource.data.created_at
        && (!('target_roles' in resource.data) || request.resource.data.target_roles == resource.data.target_roles)
        && (!('target_user_ids' in resource.data) || request.resource.data.target_user_ids == resource.data.target_user_ids)
        && (!('category' in resource.data) || request.resource.data.category == resource.data.category)
        && (!('sound' in resource.data) || request.resource.data.sound == resource.data.sound)
        && (!('hidden_by' in request.resource.data) || request.resource.data.hidden_by is list)
        && (!('hidden_by' in request.resource.data) || request.auth.uid in request.resource.data.hidden_by)
        && (!('read' in request.resource.data) || request.resource.data.read == resource.data.read || (request.resource.data.read is map && request.resource.data.read[request.auth.uid] == true));
    }

    function isValidPaymentCreate() {
      // Accepts both:
      //   - Legacy manual-payment client schema (user_name, payment_ref, type, review_mode)
      //   - Cloud Function v2 Admin SDK schema (provider_order_id, course_id, receipt_id, source, created_at_ms, payment_type)
      // Admin SDK bypasses these rules, but the rule set must not reject the unified schema.
      // INVARIANTS that MUST always hold regardless of schema version:
      //   user_id == auth.uid, state=pending, status=pending, provider=razorpay, amount>0
      return isApprovedVerifiedUser()
        && hasOnlyAllowedKeys(
          request.resource.data,
          [
            // Core fields (both schemas)
            'user_id', 'amount', 'state', 'status', 'provider', 'created_at', 'currency',
            // Legacy manual-payment fields
            'user_name', 'payment_ref', 'type', 'transaction_ref', 'review_mode', 'submitted_at',
            // Cloud Function v2 fields
            'provider_order_id', 'course_id', 'payment_type', 'receipt_id', 'created_at_ms', 'source'
          ]
        )
        && request.resource.data.user_id == request.auth.uid
        // user_name is optional in CF v2 schema (Admin SDK sets it if available)
        && (!('user_name' in request.resource.data) || (request.resource.data.user_name is string && request.resource.data.user_name.size() > 0))
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        // Security invariants: client can NEVER start in a non-pending state
        && request.resource.data.state == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.provider == 'razorpay'
        && request.resource.data.currency == 'INR'
        // Legacy-only optional fields
        && (!('type' in request.resource.data) || request.resource.data.type in ['fees', 'sadqa', 'zakat', 'fitra', 'langar'])
        && (!('transaction_ref' in request.resource.data) || (request.resource.data.transaction_ref is string && request.resource.data.transaction_ref.size() >= 4 && request.resource.data.transaction_ref.size() <= 80 && request.resource.data.transaction_ref.matches('^[a-zA-Z0-9_./# -]+$')))
        && (!('review_mode' in request.resource.data) || request.resource.data.review_mode == 'manual')
        && (!('submitted_at' in request.resource.data) || request.resource.data.submitted_at is timestamp)
        && (!('created_at' in request.resource.data) || request.resource.data.created_at is timestamp)
        // CF v2 optional fields — validation where applicable
        && (!('source' in request.resource.data) || request.resource.data.source is string)
        && (!('provider_order_id' in request.resource.data) || request.resource.data.provider_order_id is string)
        && (!('receipt_id' in request.resource.data) || request.resource.data.receipt_id is string);
    }

    function isValidPaymentUpdateByOwner() {
      // submitPaymentReference (CF) uses Admin SDK — bypasses rules.
      // This rule governs legacy client-side manual payment reference submission.
      // Security: client may ONLY change state pending->submitted and set transaction_ref.
      // Client CANNOT change: user_id, amount, provider, currency, created_at.
      // user_name and type may be absent in CF v2 docs, so check conditionally.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment_ref', 'transaction_ref', 'state', 'status', 'submitted_at'])
        && request.resource.data.user_id == resource.data.user_id
        && (!('user_name' in resource.data) || request.resource.data.user_name == resource.data.user_name)
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.provider == resource.data.provider
        && (!('type' in resource.data) || request.resource.data.type == resource.data.type)
        && (!('review_mode' in resource.data) || request.resource.data.review_mode == resource.data.review_mode)
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.created_at == resource.data.created_at
        && ((("state" in resource.data) && resource.data.state == 'pending') || resource.data.status == 'pending')
        // Security: client can ONLY move to submitted — never succeeded/processing/etc
        && request.resource.data.state == 'submitted'
        && request.resource.data.status == 'submitted'
        && (!('payment_ref' in request.resource.data) || request.resource.data.payment_ref == null || request.resource.data.payment_ref is string)
        && (!('transaction_ref' in request.resource.data) || request.resource.data.transaction_ref == null || request.resource.data.transaction_ref is string)
        && (!('submitted_at' in request.resource.data) || request.resource.data.submitted_at is timestamp);
    }

    function isValidPaymentUpdateByAdmin() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'state', 'status', 'reviewed_by', 'review_note', 'review_evidence', 'reviewed_at',
          'updated_at', 'updated_at_ms', 'reconciliation', 'entitlement_granted', 'finalized_at', 'finalized_at_ms'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['state'])
          || request.resource.data.state in ['pending', 'submitted', 'verified', 'approved', 'rejected', 'processing', 'succeeded', 'failed', 'cancelled', 'refunded', 'disputed', 'expired'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in ['pending', 'submitted', 'verified', 'approved', 'rejected', 'processing', 'succeeded', 'failed', 'cancelled', 'refunded', 'disputed', 'expired'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['state', 'status'])
          || request.resource.data.state == request.resource.data.status)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewed_by']) || request.resource.data.reviewed_by == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['review_note']) || request.resource.data.review_note is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['review_evidence']) || request.resource.data.review_evidence is map)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewed_at']) || request.resource.data.reviewed_at is timestamp)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updated_at']) || request.resource.data.updated_at is timestamp)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updated_at_ms']) || request.resource.data.updated_at_ms is number);
    }

    function isValidFeedbackCreate() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['user_id', 'user_name', 'message', 'rating', 'created_at']
        )
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_name is string
        && request.resource.data.user_name.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && (!('rating' in request.resource.data) || request.resource.data.rating == null || (request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && request.resource.data.created_at is timestamp;
    }

    function isChatParticipant() {
      return isApprovedVerifiedUser() && request.auth.uid in resource.data.participants;
    }

    function isChatParticipantByData() {
      return isApprovedVerifiedUser() && request.auth.uid in request.resource.data.participants;
    }

    function isBroadcastChat() {
      return resource.data.type == 'broadcast';
    }

    function isValidChatCreate() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['type', 'name', 'participants', 'participant_names', 'last_message', 'last_sender_id', 'created_by', 'created_at', 'updated_at', 'typing', 'unread_counts', 'pinned_by', 'hidden_by', 'archived_by', 'muted_by', 'blocked_pairs']
        )
        && request.resource.data.type in ['direct', 'group', 'broadcast']
        && request.resource.data.created_by is string
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.created_at is timestamp
        && request.resource.data.updated_at is timestamp
        && request.resource.data.participants is list
        && request.resource.data.participants.size() <= 200
        && (!('last_message' in request.resource.data) || request.resource.data.last_message is string)
        && (!('last_sender_id' in request.resource.data) || request.resource.data.last_sender_id is string)
        && (!('pinned_by' in request.resource.data) || request.resource.data.pinned_by is list)
        && (!('hidden_by' in request.resource.data) || request.resource.data.hidden_by is list)
        && (!('muted_by' in request.resource.data) || request.resource.data.muted_by is list)
        && (!('blocked_pairs' in request.resource.data) || request.resource.data.blocked_pairs is list)
        && (
          (request.resource.data.type == 'direct'
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants.size() == 2)
          || (request.resource.data.type == 'group' && isTeacherOrAdmin() && request.auth.uid in request.resource.data.participants)
          || (request.resource.data.type == 'broadcast' && isAdmin())
        );
    }

    function isValidChatBaseUnchanged() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['type', 'name', 'participants', 'participant_names', 'last_message', 'last_sender_id', 'created_by', 'created_at', 'updated_at', 'typing', 'unread_counts', 'pinned_by', 'hidden_by', 'archived_by', 'muted_by', 'blocked_pairs']
        )
        && request.resource.data.type in ['direct', 'group', 'broadcast']
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.created_at == resource.data.created_at
        && (isAdmin() || request.resource.data.participants == resource.data.participants);
    }

    function isValidChatUpdate() {
      return isValidChatBaseUnchanged()
        && (
          isAdmin()
          || (
            request.resource.data.type != 'broadcast'
            && isChatParticipant()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_message', 'last_sender_id', 'updated_at', 'typing', 'unread_counts', 'pinned_by', 'hidden_by', 'archived_by', 'muted_by', 'blocked_pairs'])
          )
          || (
            request.resource.data.type == 'broadcast'
            && isApprovedVerifiedUser()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned_by', 'hidden_by', 'muted_by'])
          )
        );
    }

    function canReadChat() {
      return isApprovedVerifiedUser() && (resource == null || isBroadcastChat() || isChatParticipant());
    }

    function canWriteMessageToChat(chatId) {
      return isApprovedVerifiedUser()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && !(
          ('blocked_pairs' in get(/databases/$(database)/documents/chats/$(chatId)).data)
          && (
            (request.auth.uid + ':' + get(/databases/$(database)/documents/chats/$(chatId)).data.created_by) in get(/databases/$(database)/documents/chats/$(chatId)).data.blocked_pairs
            || (get(/databases/$(database)/documents/chats/$(chatId)).data.created_by + ':' + request.auth.uid) in get(/databases/$(database)/documents/chats/$(chatId)).data.blocked_pairs
          )
        )
        && (
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'broadcast'
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )
          || (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'broadcast'
            && isAdmin()
          )
        );
    }

    function canReadMessage() {
      return isApprovedVerifiedUser()
        && exists(/databases/$(database)/documents/chats/$(resource.data.chat_id))
        && (
          get(/databases/$(database)/documents/chats/$(resource.data.chat_id)).data.type == 'broadcast'
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chat_id)).data.participants
        );
    }

    function hasValidMessageKeys(data) {
      return hasOnlyAllowedKeys(data, ['chat_id', 'text', 'sender_id', 'sender_name', 'created_at', 'read_by', 'client_id', 'deleted_for', 'deleted_for_everyone', 'is_deleted', 'unsent_by', 'unsent_at', 'message_type', 'media_url', 'media_name', 'media_size', 'mime_type', 'status', 'sent_at', 'delivered_at', 'seen_at', 'failed_reason', 'retry_count', 'push_dedupe_id', 'reply_to', 'reply_snippet', 'reactions']);
    }

    function isValidMessageCreate() {
      return canWriteMessageToChat(request.resource.data.chat_id)
        && hasValidMessageKeys(request.resource.data)
        && request.resource.data.text is string
        && (request.resource.data.text.size() > 0 || (('media_url' in request.resource.data) && request.resource.data.media_url is string && request.resource.data.media_url.size() > 0))
        && request.resource.data.sender_id == request.auth.uid
        && request.resource.data.created_at is timestamp
        && request.resource.data.read_by is list
        && request.auth.uid in request.resource.data.read_by
        && (!('client_id' in request.resource.data) || request.resource.data.client_id is string)
        && (!('deleted_for' in request.resource.data) || request.resource.data.deleted_for is list)
        && (!('deleted_for_everyone' in request.resource.data) || request.resource.data.deleted_for_everyone is bool)
        && (!('is_deleted' in request.resource.data) || request.resource.data.is_deleted is bool)
        && (!('message_type' in request.resource.data) || request.resource.data.message_type in ['text', 'image', 'video', 'audio', 'document'])
        && (!('media_url' in request.resource.data) || request.resource.data.media_url is string)
        && (!('media_name' in request.resource.data) || request.resource.data.media_name is string)
        && (!('media_size' in request.resource.data) || request.resource.data.media_size is number)
        && (!('mime_type' in request.resource.data) || request.resource.data.mime_type is string)
        && (!('reply_to' in request.resource.data) || request.resource.data.reply_to is string)
        && (!('reply_snippet' in request.resource.data) || request.resource.data.reply_snippet is string)
        && (!('reactions' in request.resource.data) || request.resource.data.reactions is map)
        && (!('status' in request.resource.data) || request.resource.data.status in ['sending', 'sent', 'delivered', 'seen', 'failed', 'retrying'])
        && (!('sent_at' in request.resource.data) || request.resource.data.sent_at is timestamp)
        && (!('delivered_at' in request.resource.data) || request.resource.data.delivered_at == null || request.resource.data.delivered_at is timestamp)
        && (!('seen_at' in request.resource.data) || request.resource.data.seen_at == null || request.resource.data.seen_at is timestamp)
        && (!('failed_reason' in request.resource.data) || request.resource.data.failed_reason is string)
        && (!('retry_count' in request.resource.data) || request.resource.data.retry_count is number)
        && (!('push_dedupe_id' in request.resource.data) || request.resource.data.push_dedupe_id is string);
    }

    function isValidMessageUpdate() {
      return canReadMessage()
        && hasValidMessageKeys(request.resource.data)
        && request.resource.data.chat_id == resource.data.chat_id
        && request.resource.data.sender_id == resource.data.sender_id
        && request.resource.data.sender_name == resource.data.sender_name
        && request.resource.data.created_at == resource.data.created_at
        && (!('client_id' in resource.data) || request.resource.data.client_id == resource.data.client_id)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by'])
            && request.resource.data.text == resource.data.text
            && request.resource.data.read_by is list
            && request.auth.uid in request.resource.data.read_by
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'delivered_at', 'seen_at', 'read_by'])
            && request.resource.data.status in ['delivered', 'seen']
            && request.resource.data.read_by is list
            && request.auth.uid in request.resource.data.read_by
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted_for'])
            && request.resource.data.text == resource.data.text
            && request.resource.data.deleted_for is list
            && request.auth.uid in request.resource.data.deleted_for
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map
          )
          || (
            (request.auth.uid == resource.data.sender_id || isAdmin())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted_for_everyone', 'is_deleted', 'unsent_by', 'unsent_at', 'media_url', 'media_name'])
            && (request.resource.data.text == 'This message was unsent.' || request.resource.data.text == 'This message was deleted.')
            && (request.resource.data.deleted_for_everyone == true || request.resource.data.is_deleted == true)
            && request.resource.data.unsent_by == request.auth.uid
            && request.resource.data.unsent_at is timestamp
          )
        );
    }

    function isValidStatusCreate() {
      return isTeacherOrAdmin()
        && hasOnlyAllowedKeys(request.resource.data, ['user_id', 'user_name', 'role', 'text', 'media_url', 'media_type', 'likes', 'comments', 'created_at', 'audience', 'audience_user_ids', 'hidden_user_ids', 'muted_by', 'reaction_counts', 'expires_at_ms'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_name is string
        && request.resource.data.role in ['teacher', 'admin']
        && request.resource.data.text is string
        && (!('media_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.media_url))
        && (!('media_type' in request.resource.data) || request.resource.data.media_type in ['', 'image', 'video'])
        && request.resource.data.likes is list
        && request.resource.data.comments is list
        && (!('audience' in request.resource.data) || request.resource.data.audience in ['everyone', 'teachers', 'students', 'custom'])
        && (!('audience_user_ids' in request.resource.data) || request.resource.data.audience_user_ids is list)
        && (!('hidden_user_ids' in request.resource.data) || request.resource.data.hidden_user_ids is list)
        && (!('muted_by' in request.resource.data) || request.resource.data.muted_by is list)
        && (!('reaction_counts' in request.resource.data) || request.resource.data.reaction_counts is map)
        && (!('expires_at_ms' in request.resource.data) || request.resource.data.expires_at_ms is number)
        && request.resource.data.created_at is timestamp;
    }

    function isValidStatusInteractionUpdate() {
      return isStudent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'hidden_user_ids', 'muted_by', 'reaction_counts'])
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user_name == resource.data.user_name
        && request.resource.data.role == resource.data.role
        && request.resource.data.text == resource.data.text
        && request.resource.data.media_url == resource.data.media_url
        && request.resource.data.media_type == resource.data.media_type
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.likes is list
        && request.resource.data.comments is list
        && (!('hidden_user_ids' in request.resource.data) || request.auth.uid in request.resource.data.hidden_user_ids)
        && (!('muted_by' in request.resource.data) || request.auth.uid in request.resource.data.muted_by);
    }


    function isValidAttendanceRecord() {
      return hasOnlyAllowedKeys(
          request.resource.data,
          ['user_id', 'user_name', 'user_email', 'date', 'status', 'marked_by', 'marked_by_uid', 'marked_by_name', 'created_at', 'marked_at', 'updated_at', 'live_class_id', 'course_id', 'duration_seconds']
        )
        && isTeacherOrAdmin()
        && request.resource.data.user_id is string
        && request.resource.data.user_id.size() > 0
        && exists(/databases/$(database)/documents/users/$(request.resource.data.user_id))
        && get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.status == 'approved'
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status in ['present', 'absent']
        && request.resource.data.marked_by in ['teacher', 'admin', 'live_class']
        && request.resource.data.marked_by_uid == request.auth.uid
        && request.resource.data.marked_by_name is string
        && (!('user_name' in request.resource.data) || request.resource.data.user_name is string)
        && (!('user_email' in request.resource.data) || request.resource.data.user_email is string)
        && request.resource.data.marked_at is timestamp
        && request.resource.data.updated_at is timestamp
        && (!('live_class_id' in request.resource.data) || request.resource.data.live_class_id is string)
        && (!('course_id' in request.resource.data) || request.resource.data.course_id is string)
        && (!('duration_seconds' in request.resource.data) || (request.resource.data.duration_seconds is number && request.resource.data.duration_seconds >= 0 && request.resource.data.duration_seconds <= 43200))
        && (!('created_at' in request.resource.data) || request.resource.data.created_at is timestamp);
    }

    function isAttendanceRecordUnchangedOwner() {
      return resource.data.user_id == request.resource.data.user_id
        && resource.data.date == request.resource.data.date
        && (!('created_at' in resource.data) || request.resource.data.created_at == resource.data.created_at);
    }



    function liveClassDoc(classId) {
      return get(/databases/$(database)/documents/live_classes/$(classId));
    }

    function isLiveClassTeacherOrAdmin(data) {
      return isSignedIn()
        && (
          isAdmin()
          || (isTeacherOrAdmin() && data.teacher_id == request.auth.uid)
        );
    }

    function enrollmentDocId(uid, courseId) {
      return uid + ':' + courseId;
    }

    function activeEnrollmentDoc(courseId) {
      return get(/databases/$(database)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId)));
    }

    function hasActiveEnrollmentForCourse(courseId) {
      return isApprovedVerifiedUser()
        && courseId is string
        && courseId.size() > 0
        && exists(/databases/$(database)/documents/enrollments/$(enrollmentDocId(request.auth.uid, courseId)))
        && activeEnrollmentDoc(courseId).data.user_id == request.auth.uid
        && activeEnrollmentDoc(courseId).data.course_id == courseId
        && activeEnrollmentDoc(courseId).data.status == 'active';
    }

    function allowsLegacyCourseAccessWhenEnrollmentMissing(data) {
      return isStudent()
        && (!('enrollment_source' in data) || data.enrollment_source != 'enrollments')
        && data.course_id is string
        && data.course_id.size() > 0
        && exists(/databases/$(database)/documents/courses/$(data.course_id))
        && !exists(/databases/$(database)/documents/enrollments/$(enrollmentDocId(request.auth.uid, data.course_id)));
    }

    function canJoinLiveClassData(data) {
      return isApprovedVerifiedUser()
        && data.status == 'live'
        && (
          isTeacherOrAdmin()
          || hasActiveEnrollmentForCourse(data.course_id)
          || allowsLegacyCourseAccessWhenEnrollmentMissing(data)
        );
    }

    function canReadLiveClassData(data) {
      return isApprovedVerifiedUser()
        && (
          isTeacherOrAdmin()
          || hasActiveEnrollmentForCourse(data.course_id)
          || allowsLegacyCourseAccessWhenEnrollmentMissing(data)
        );
    }

    function isValidLiveClassWrite() {
      return hasOnlyAllowedKeys(request.resource.data, [
          'course_id', 'lesson_id', 'teacher_id', 'teacher_name', 'title', 'status',
          'meet_url', 'started_at', 'ended_at', 'created_at', 'updated_at'
        ])
        && request.resource.data.course_id is string
        && request.resource.data.teacher_id is string
        && request.resource.data.title is string
        && request.resource.data.status in ['scheduled', 'waiting_room', 'live', 'paused', 'reconnecting', 'ended', 'cancelled']
        && (!('meet_url' in request.resource.data) || request.resource.data.meet_url is string)
        && (!('lesson_id' in request.resource.data) || request.resource.data.lesson_id is string)
        && (!('started_at' in request.resource.data) || request.resource.data.started_at is timestamp)
        && (!('ended_at' in request.resource.data) || request.resource.data.ended_at is timestamp)
        && request.resource.data.updated_at is timestamp;
    }



    function isValidAudioLessonWrite() {
      return hasOnlyAllowedKeys(request.resource.data, [
          'title', 'title_lower', 'description', 'course_id', 'teacher_id', 'duration',
          'upload_date', 'updated_at', 'audio_url', 'file_size', 'file_name', 'mime_type', 'storage_path'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.title_lower is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.course_id is string
        && request.resource.data.course_id.size() > 0
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.course_id))
        && request.resource.data.teacher_id is string
        && request.resource.data.duration is number
        && request.resource.data.duration >= 0
        && request.resource.data.duration <= 21600
        && request.resource.data.upload_date is timestamp
        && request.resource.data.updated_at is timestamp
        && request.resource.data.audio_url is string
        && request.resource.data.audio_url.matches('^https://.*$')
        && request.resource.data.file_size is number
        && request.resource.data.file_size > 0
        && request.resource.data.file_size <= 104857600
        && request.resource.data.file_name is string
        && request.resource.data.mime_type in ['audio/mpeg', 'audio/mp4', 'audio/m4a', 'audio/x-m4a', 'audio/aac', 'audio/aacp']
        && request.resource.data.storage_path is string
        && request.resource.data.storage_path.matches('^audio_lessons/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$');
    }

    function canManageAudioLesson(data) {
      return isAdmin() || (isApprovedTeacher() && data.teacher_id == request.auth.uid);
    }



    // canReadLearningContent: base check used by categories, quizzes, audio_lessons.
    // modules, lessons, assignments use canReadLearningContentForCourse which
    // additionally enforces enrollment for courses that have a course_id set.
    function canReadLearningContent(data) {
      return isApprovedVerifiedUser();
    }

    // For content tied to a specific course, require active enrollment.
    // Teachers/admins bypass enrollment check (they can see all content).
    function canReadCourseData(courseId, data) {
      // Course metadata (title, description, price) is readable by all approved users.
      // Course content (lessons, modules) requires enrollment — see canReadLearningContentForCourse.
      return canReadLearningContent(data);
    }

    function canReadLearningContentForCourse(data) {
      return isApprovedVerifiedUser()
        && (
          isTeacherOrAdmin()
          || !('course_id' in data)
          || data.course_id == null
          || data.course_id == ''
          || hasActiveEnrollmentForCourse(data.course_id)
        );
    }

    function canReadRecordingData(data) {
      return isApprovedVerifiedUser()
        && (
          !('live_class_id' in data)
          || data.live_class_id == ''
          || (data.live_class_id is string
            && exists(/databases/$(database)/documents/live_classes/$(data.live_class_id))
            && canReadLiveClassData(get(/databases/$(database)/documents/live_classes/$(data.live_class_id)).data))
        );
    }

    function isValidLiveParticipantShape(data, classId, userId) {
      return hasOnlyAllowedKeys(data, [
          'user_id', 'agora_uid', 'name', 'role', 'joined', 'audio_enabled', 'video_enabled',
          'force_muted', 'is_speaking', 'joined_at', 'last_joined_at', 'left_at', 'total_duration_seconds',
          'updated_at', 'hand_raised', 'moderation', 'reconnect_count', 'disconnected', 'session_id',
          'joined_session_at', 'last_reconnected_at', 'total_connected_duration', 'heartbeat_at', 'last_seen_at'
        ])
        && data.user_id == userId
        && data.agora_uid is number
        && data.name is string
        && data.name.size() > 0
        && data.role in ['student', 'teacher', 'assistant_teacher', 'moderator', 'admin', 'super_admin']
        && data.joined is bool
        && data.audio_enabled is bool
        && data.video_enabled is bool
        && (!('force_muted' in data) || data.force_muted is bool)
        && (!('is_speaking' in data) || data.is_speaking is bool)
        && (!('hand_raised' in data) || data.hand_raised is bool)
        && (!('reconnect_count' in data) || data.reconnect_count is number)
        && (!('disconnected' in data) || data.disconnected is bool)
        && (!('session_id' in data) || data.session_id is string)
        && (!('total_duration_seconds' in data) || (data.total_duration_seconds is number && data.total_duration_seconds >= 0 && data.total_duration_seconds <= 43200))
        && (!('total_connected_duration' in data) || (data.total_connected_duration is number && data.total_connected_duration >= 0 && data.total_connected_duration <= 43200))
        && (!('moderation' in data) || (data.moderation is map
          && data.moderation.keys().hasOnly(['mic_allowed', 'camera_allowed', 'removed', 'moderated_at', 'moderated_by', 'moderation_reason'])
          && (!('mic_allowed' in data.moderation) || data.moderation.mic_allowed is bool)
          && (!('camera_allowed' in data.moderation) || data.moderation.camera_allowed is bool)
          && (!('removed' in data.moderation) || data.moderation.removed is bool)
          && (!('moderated_at' in data.moderation) || data.moderation.moderated_at is timestamp)
          && (!('moderated_by' in data.moderation) || data.moderation.moderated_by is string)
          && (!('moderation_reason' in data.moderation) || data.moderation.moderation_reason is string)))
        && (!('joined_at' in data) || data.joined_at is timestamp)
        && (!('last_joined_at' in data) || data.last_joined_at is timestamp)
        && (!('left_at' in data) || data.left_at is timestamp)
        && (!('joined_session_at' in data) || data.joined_session_at is timestamp)
        && (!('last_reconnected_at' in data) || data.last_reconnected_at is timestamp)
        && (!('heartbeat_at' in data) || data.heartbeat_at is timestamp)
        && (!('last_seen_at' in data) || data.last_seen_at is timestamp)
        && data.updated_at is timestamp;
    }

    function isValidLiveParticipantWrite(classId, userId) {
      return isValidLiveParticipantShape(request.resource.data, classId, userId)
        && canJoinLiveClassData(liveClassDoc(classId).data);
    }

    function isValidParticipantCountOnlyUpdate(classId) {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participant_count', 'updated_at'])
        && request.resource.data.participant_count is number
        && request.resource.data.participant_count >= 0
        && request.resource.data.participant_count <= 500
        && request.resource.data.updated_at is timestamp
        && canJoinLiveClassData(resource.data);
    }

    function isValidLiveParticipantModeration(classId, userId) {
      return isLiveClassTeacherOrAdmin(liveClassDoc(classId).data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'force_muted', 'audio_enabled', 'video_enabled', 'joined', 'hand_raised', 'moderation', 'updated_at', 'last_seen_at'
        ])
        && isValidLiveParticipantShape(request.resource.data, classId, userId)
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.agora_uid == resource.data.agora_uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.role == resource.data.role;
    }

    function isValidLiveModerationEventCreate(classId) {
      return isLiveClassTeacherOrAdmin(liveClassDoc(classId).data)
        && hasOnlyAllowedKeys(request.resource.data, ['type', 'target_user', 'moderated_by', 'timestamp', 'reason', 'success'])
        && request.resource.data.type in ['mute', 'remove']
        && request.resource.data.target_user is string
        && request.resource.data.moderated_by == request.auth.uid
        && request.resource.data.timestamp is timestamp
        && request.resource.data.success is bool
        && (!('reason' in request.resource.data) || request.resource.data.reason is string);
    }



    function isValidLegalAcceptance(uid) {
      return isSelf(uid)
        && hasOnlyAllowedKeys(request.resource.data, ['accepted', 'acceptance_updated_at', 'policy_bundle_version', 'is_minor', 'age_bracket', 'guardian_name', 'guardian_phone'])
        && request.resource.data.accepted is map
        && request.resource.data.accepted.keys().hasOnly(['terms', 'privacy', 'community', 'minor_guardian_consent'])
        && (!('terms' in request.resource.data.accepted)
          || (request.resource.data.accepted.terms is map
            && request.resource.data.accepted.terms.version is string
            && request.resource.data.accepted.terms.acceptedAt is timestamp))
        && (!('privacy' in request.resource.data.accepted)
          || (request.resource.data.accepted.privacy is map
            && request.resource.data.accepted.privacy.version is string
            && request.resource.data.accepted.privacy.acceptedAt is timestamp))
        && (!('community' in request.resource.data.accepted)
          || (request.resource.data.accepted.community is map
            && request.resource.data.accepted.community.version is string
            && request.resource.data.accepted.community.acceptedAt is timestamp))
        && (!('minor_guardian_consent' in request.resource.data.accepted)
          || (request.resource.data.accepted.minor_guardian_consent is map
            && request.resource.data.accepted.minor_guardian_consent.version is string
            && request.resource.data.accepted.minor_guardian_consent.acceptedAt is timestamp))
        && (!('is_minor' in request.resource.data) || request.resource.data.is_minor is bool)
        && (!('age_bracket' in request.resource.data) || request.resource.data.age_bracket is string)
        && (!('guardian_name' in request.resource.data) || request.resource.data.guardian_name is string)
        && (!('guardian_phone' in request.resource.data) || request.resource.data.guardian_phone is string)
        && request.resource.data.acceptance_updated_at is timestamp
        && request.resource.data.policy_bundle_version is string;
    }

    function isValidLegalAuditCreate() {
      return isSignedIn()
        && hasOnlyAllowedKeys(request.resource.data, ['user_id', 'event', 'accepted_docs', 'accepted_versions', 'created_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.event == 'legal_acceptance'
        && request.resource.data.accepted_docs is list
        && request.resource.data.accepted_docs.size() <= 3
        && request.resource.data.accepted_docs.hasOnly(['terms', 'privacy', 'community'])
        && request.resource.data.accepted_versions is list
        && request.resource.data.accepted_versions.size() <= 3
        && request.resource.data.created_at is timestamp;
    }

    function isValidPrivacyRequestCreate() {
      return isApprovedVerifiedUser()
        && hasOnlyAllowedKeys(request.resource.data, ['user_id', 'type', 'reason', 'state', 'lifecycle', 'created_at', 'updated_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.type in ['deletion', 'export']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 8
        && request.resource.data.reason.size() <= 600
        && request.resource.data.state == 'requested'
        && request.resource.data.lifecycle is list
        && request.resource.data.lifecycle.size() <= 10
        && request.resource.data.created_at is timestamp
        && request.resource.data.updated_at is timestamp;
    }

    function isValidNotificationSettings(uid) {
      return isSelf(uid)
        && hasOnlyAllowedKeys(request.resource.data, ['channels', 'muted_chat_ids', 'quiet_hours', 'sound_enabled', 'vibration_enabled', 'updated_at_ms', 'updated_at'])
        && (!('channels' in request.resource.data) || request.resource.data.channels is map)
        && (!('muted_chat_ids' in request.resource.data) || (request.resource.data.muted_chat_ids is list && request.resource.data.muted_chat_ids.size() <= 200))
        && (!('quiet_hours' in request.resource.data) || request.resource.data.quiet_hours is map)
        && (!('sound_enabled' in request.resource.data) || request.resource.data.sound_enabled is bool)
        && (!('vibration_enabled' in request.resource.data) || request.resource.data.vibration_enabled is bool)
        && request.resource.data.updated_at_ms is number
        && request.resource.data.updated_at is timestamp;
    }

    function hasValidCallKeys(data) {
      return hasOnlyAllowedKeys(data, [
        'caller_id', 'callee_id', 'status', 'mode', 'channel_name', 'agora_app_id',
        'caller_agora_uid', 'callee_agora_uid', 'expires_at_epoch', 'last_heartbeat_at',
        'caller_last_seen', 'callee_last_seen', 'created_at', 'updated_at', 'finalized_at',
        'termination_reason', 'cleanup_reason', 'timeout_reason', 'failed_reason'
      ]);
    }

    function isCallParticipantData(data) {
      return isApprovedVerifiedUser() && (data.caller_id == request.auth.uid || data.callee_id == request.auth.uid || isAdmin());
    }

    function isValidCallCreate() {
      return isApprovedVerifiedUser()
        && hasValidCallKeys(request.resource.data)
        && request.resource.data.caller_id == request.auth.uid
        && request.resource.data.callee_id is string
        && request.resource.data.callee_id != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.mode in ['audio', 'video']
        && request.resource.data.channel_name is string
        && request.resource.data.channel_name.size() > 0
        && request.resource.data.channel_name.size() <= 160
        && (!('agora_app_id' in request.resource.data) || request.resource.data.agora_app_id is string)
        && request.resource.data.caller_agora_uid is number
        && request.resource.data.callee_agora_uid is number
        && request.resource.data.expires_at_epoch is number
        && request.resource.data.last_heartbeat_at is number
        && request.resource.data.caller_last_seen is number
        && request.resource.data.callee_last_seen is number
        && request.resource.data.created_at is timestamp
        && request.resource.data.updated_at is timestamp;
    }

    function isValidCallUpdate() {
      return isCallParticipantData(resource.data)
        && hasValidCallKeys(request.resource.data)
        && request.resource.data.caller_id == resource.data.caller_id
        && request.resource.data.callee_id == resource.data.callee_id
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.channel_name == resource.data.channel_name
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.status in ['initiating', 'ringing', 'connecting', 'connected', 'reconnecting', 'failed', 'ended', 'declined', 'missed']
        && request.resource.data.updated_at is timestamp
        && (!('last_heartbeat_at' in request.resource.data) || request.resource.data.last_heartbeat_at is number)
        && (!('caller_last_seen' in request.resource.data) || request.resource.data.caller_last_seen is number)
        && (!('callee_last_seen' in request.resource.data) || request.resource.data.callee_last_seen is number)
        && (!('finalized_at' in request.resource.data) || request.resource.data.finalized_at is timestamp)
        && (!('termination_reason' in request.resource.data) || request.resource.data.termination_reason is string)
        && (!('cleanup_reason' in request.resource.data) || request.resource.data.cleanup_reason is string)
        && (!('timeout_reason' in request.resource.data) || request.resource.data.timeout_reason is string)
        && (!('failed_reason' in request.resource.data) || request.resource.data.failed_reason is string);
    }

    function isValidCallParticipantWrite(callId, uid) {
      return isSelf(uid)
        && exists(/databases/$(database)/documents/calls/$(callId))
        && isCallParticipantData(get(/databases/$(database)/documents/calls/$(callId)).data)
        && hasOnlyAllowedKeys(request.resource.data, ['joined', 'reconnecting', 'muted', 'last_seen', 'device_platform', 'updated_at'])
        && request.resource.data.joined is bool
        && request.resource.data.reconnecting is bool
        && request.resource.data.muted is bool
        && request.resource.data.last_seen is number
        && request.resource.data.device_platform is string
        && request.resource.data.updated_at is timestamp;
    }

    // users collection
    match /users/{uid} {
      // Users can read their own profile; signed-in users can list users for app pickers/referrals.
      allow get: if isAdmin() || isSelf(uid);
      allow list: if isAdmin() || isTeacherOrAdmin();

      // Self-signup profile creation.
      allow create: if isValidUserCreate(uid);

      // Admin can fully update users; users can update own push/profile/login metadata.
      allow update: if (isAdmin() && isValidUserUpdateByAdmin()) || isValidSelfUserMetadataUpdate(uid) || isValidReferralCountIncrement();
      allow delete: if isAdmin() && (!resource.data.get('founder', false) || isSuperAdmin());
    }

    match /users/{uid}/compliance/{docId} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update: if docId == 'legal_acceptance' && isValidLegalAcceptance(uid);
      allow delete: if isAdmin();
    }

    match /presence/{uid} {
      allow read: if isApprovedVerifiedUser();
      allow write: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['is_online', 'last_seen', 'device_type'])
        && request.resource.data.is_online is bool
        && request.resource.data.last_seen is timestamp;
    }

    match /public_profiles/{uid} {
      allow get, list: if isApprovedVerifiedUser();
      allow create: if (isSelf(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.uid == uid
          && request.resource.data.role == userDoc(uid).role
          && request.resource.data.status == userDoc(uid).status
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.searchable is bool
          && request.resource.data.is_active is bool
          && request.resource.data.searchable == (userDoc(uid).status == 'approved')
          && request.resource.data.is_active == (userDoc(uid).status == 'approved')
          && (!('photo_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.photo_url))
          && (!('avatar' in request.resource.data) || request.resource.data.avatar is string)
          && (!('updated_at' in request.resource.data) || request.resource.data.updated_at is timestamp)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'status', 'searchable', 'is_active', 'photo_url', 'avatar', 'updated_at']))
        || isAdmin();
      allow update: if (isSelf(uid)
          && isVerified()
          && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.uid == uid
          && request.resource.data.role == userDoc(uid).role
          && request.resource.data.status == userDoc(uid).status
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.searchable is bool
          && request.resource.data.is_active is bool
          && request.resource.data.searchable == (userDoc(uid).status == 'approved')
          && request.resource.data.is_active == (userDoc(uid).status == 'approved')
          && (!('photo_url' in request.resource.data) || isBlankOrHttpsUrl(request.resource.data.photo_url))
          && (!('avatar' in request.resource.data) || request.resource.data.avatar is string)
          && (!('updated_at' in request.resource.data) || request.resource.data.updated_at is timestamp)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'status', 'searchable', 'is_active', 'photo_url', 'avatar', 'updated_at']))
        || isAdmin();
      allow delete: if (isSelf(uid) && isVerified()) || isAdmin();
    }

    // courses collection
    match /courses/{courseId} {
      allow read: if canReadCourseData(courseId, resource.data);
      allow create, update: if isAdmin() && isValidCourseWrite();
      allow delete: if isAdmin();
    }

    // teachers collection
    match /teachers/{teacherId} {
      allow read: if isApprovedVerifiedUser();
      allow create, update: if isAdmin() && isValidTeacherWrite();
      allow delete: if isAdmin();
    }

    // library collection
    match /library/{bookId} {
      allow read: if isApprovedVerifiedUser();
      allow create, update: if isAdmin() && isValidLibraryWrite();
      allow delete: if isAdmin();
    }

    // attendance collection
    match /attendance/{attendanceId} {
      allow read: if isTeacherOrAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow create: if isValidAttendanceRecord();
      allow update: if isValidAttendanceRecord() && isAttendanceRecordUnchangedOwner();
      allow delete: if isAdmin();
    }

    // notifications collection
    match /notifications/{notificationId} {
      // Single-document reads use the existing flexible OR logic.
      allow get: if canReadNotification();

      // Collection queries (list) need query-provable constraints.
      // Firestore cannot prove `get().data.role in resource.data.target_roles`
      // (combines runtime get() with resource.data) or `field is list` type
      // guards from array-contains query constraints. Per-document role
      // verification is enforced by the allow get rule via canReadNotification().
      allow list: if isApprovedVerifiedUser()
        && (
          // Query: where user_id == 'all' orderBy created_at desc
          resource.data.user_id == 'all'
          // Query: where user_id in [<uid>, 'all'] orderBy created_at desc
          || resource.data.user_id == request.auth.uid
          // Query: where user_id == 'role_targeted', target_roles array-contains <role>
          || resource.data.user_id == 'role_targeted'
        );

      // Admin can create/modify; teachers can create direct class notifications; users can create own local result notifications.
      allow create: if isValidNotificationCreate();
      allow update: if (isAdmin() && isValidNotificationWrite()) || isValidNotificationReadUpdate();
      allow delete: if isAdmin();
    }

    // chats collection
    match /chats/{chatId} {
      allow read: if canReadChat();
      allow create: if isApprovedVerifiedUser() && isValidChatCreate();
      allow update: if canReadChat() && isValidChatUpdate();
      allow delete: if isAdmin();
    }

    // messages collection
    match /messages/{messageId} {
      allow read: if canReadMessage();
      allow create: if isValidMessageCreate();
      allow update: if isValidMessageUpdate();
      allow delete: if false;
    }


    // status updates collection
    match /status_updates/{statusId} {
      allow read: if isApprovedVerifiedUser();
      allow create: if isValidStatusCreate();
      allow update: if isValidStatusInteractionUpdate();
      allow delete: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
    }

    match /status_updates/{statusId}/comments/{commentId} {
      allow read: if isApprovedVerifiedUser();
      allow create: if isApprovedVerifiedUser()
        && request.resource.data.keys().hasOnly(['id', 'user_id', 'user_name', 'user_avatar', 'text', 'created_at', 'created_at_ms', 'edited_at', 'deleted'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.id == commentId
        && request.resource.data.text is string
        && request.resource.data.created_at_ms is number;
      allow update: if isApprovedVerifiedUser()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_at_ms == resource.data.created_at_ms
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited_at', 'deleted']);
      allow delete: if false;
    }

    match /status_updates/{statusId}/reactions/{uid} {
      allow read: if isApprovedVerifiedUser();
      allow create, update: if isApprovedVerifiedUser()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['reaction', 'user_id', 'updated_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.reaction in ['❤️', '🔥', '👏'];
      allow delete: if isApprovedVerifiedUser() && uid == request.auth.uid;
    }

    match /status_updates/{statusId}/views/{viewerId} {
      allow read: if isAdmin() || (isApprovedVerifiedUser() && (viewerId == request.auth.uid || get(/databases/$(database)/documents/status_updates/$(statusId)).data.user_id == request.auth.uid));
      allow create, update: if isApprovedVerifiedUser() && viewerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['user_id', 'viewed_at', 'viewed_at_ms'])
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }
 
    match /status_reports/{reportId} {
      allow read: if isAdmin() || (isApprovedVerifiedUser() && resource.data.reporter_id == request.auth.uid);
      allow create: if isApprovedVerifiedUser()
        && request.resource.data.keys().hasOnly(['reporter_id', 'status_id', 'owner_id', 'reason', 'created_at'])
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.status_id is string
        && request.resource.data.owner_id is string
        && request.resource.data.reason is string
        && request.resource.data.created_at is timestamp;
      allow update, delete: if isAdmin();
    }

    // Backward-compatible alias if a build writes chat_messages instead of messages.
    match /chat_messages/{messageId} {
      allow read: if canReadMessage();
      allow create: if isValidMessageCreate();
      allow update: if isValidMessageUpdate();
      allow delete: if false;
    }

    match /message_reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporter_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['reporter_id', 'target_user_id', 'target_message_id', 'reason', 'created_at'])
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.target_user_id is string
        && request.resource.data.target_message_id is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 2
        && request.resource.data.created_at is timestamp;
      allow update, delete: if isAdmin();
    }

    // payments collection
    match /payments/{paymentId} {
      allow get: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow list: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow create: if isApprovedVerifiedUser() && isValidPaymentCreate();
      allow update: if (isAdmin() && isValidPaymentUpdateByAdmin())
        || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid && isValidPaymentUpdateByOwner());
      allow delete: if isAdmin();
    }



    match /payment_gateway_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payment_processor_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payment_verification_queue/{queueId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // modules/lessons/assignments and related learning data
    match /categories/{categoryId} {
      allow read: if canReadLearningContent(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if canReadLearningContent(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /quiz_results/{resultId} {
      allow get: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow list: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      // SECURITY FIX (Phase 8): Students MUST NOT write quiz results directly to Firestore.
      // All quiz submissions must go through the /lms/quiz/submit backend API endpoint,
      // which performs server-side grading and deduplication.
      // Direct client writes would allow score manipulation (e.g. always submitting score=10/10).
      allow create: if false;  // Server-only via Admin SDK
      allow update, delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow get: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow list: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow create: if false;
      allow update, delete: if isAdmin();
    }


    match /enrollments/{enrollmentId} {
      allow read: if isTeacherOrAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow create, update: if isAdmin()
        && request.resource.data.user_id is string
        && request.resource.data.course_id is string
        && enrollmentId == enrollmentDocId(request.resource.data.user_id, request.resource.data.course_id);
      allow delete: if isAdmin();
    }

    match /modules/{moduleId} {
      // Phase 8: Modules are course-specific content; require active enrollment.
      allow read: if canReadLearningContentForCourse(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      // Phase 8: Lessons are course-specific content; require active enrollment.
      allow read: if canReadLearningContentForCourse(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      // Phase 8: Assignments are course-specific; require active enrollment.
      allow read: if canReadLearningContentForCourse(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /lesson_progress/{progressId} {
      allow read: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow create, update: if isAdmin()
        || (isApprovedVerifiedUser()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.lesson_id is string
          && request.resource.data.keys().hasOnly(['user_id', 'lesson_id', 'course_id', 'module_id', 'completed', 'quiz_completed', 'completed_at', 'last_opened_at', 'updated_at'])
          && (!('course_id' in request.resource.data) || request.resource.data.course_id is string)
          && (!('module_id' in request.resource.data) || request.resource.data.module_id is string)
          && (!('completed' in request.resource.data) || request.resource.data.completed is bool)
          && (!('quiz_completed' in request.resource.data) || request.resource.data.quiz_completed is bool)
          && (!('completed_at' in request.resource.data) || request.resource.data.completed_at is timestamp)
          && (!('last_opened_at' in request.resource.data) || request.resource.data.last_opened_at is timestamp)
          && (!('updated_at' in request.resource.data) || request.resource.data.updated_at is timestamp));
      allow delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isTeacherOrAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow create: if isTeacherOrAdmin()
        || (isApprovedVerifiedUser()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.keys().hasOnly(['assignment_id', 'user_id', 'file_url', 'file_name', 'mime_type', 'text_answer', 'status', 'submitted_at', 'created_at', 'updated_at'])
          && request.resource.data.assignment_id is string
          && (!('file_url' in request.resource.data) || request.resource.data.file_url is string)
          && (!('file_name' in request.resource.data) || request.resource.data.file_name is string)
          && (!('mime_type' in request.resource.data) || request.resource.data.mime_type is string)
          && (!('text_answer' in request.resource.data) || request.resource.data.text_answer is string)
          && request.resource.data.status == 'submitted'
          && (!('submitted_at' in request.resource.data) || request.resource.data.submitted_at is timestamp)
          && (!('created_at' in request.resource.data) || request.resource.data.created_at is timestamp)
          && (!('updated_at' in request.resource.data) || request.resource.data.updated_at is timestamp));
      allow update: if isTeacherOrAdmin()
        || (isApprovedVerifiedUser()
          && resource.data.user_id == request.auth.uid
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.assignment_id == resource.data.assignment_id
          && request.resource.data.keys().hasOnly(['assignment_id', 'user_id', 'file_url', 'file_name', 'mime_type', 'text_answer', 'status', 'submitted_at', 'created_at', 'updated_at'])
          && request.resource.data.status == 'submitted'
          && (!('file_url' in request.resource.data) || request.resource.data.file_url is string)
          && (!('file_name' in request.resource.data) || request.resource.data.file_name is string)
          && (!('mime_type' in request.resource.data) || request.resource.data.mime_type is string)
          && (!('text_answer' in request.resource.data) || request.resource.data.text_answer is string)
          && (!('submitted_at' in request.resource.data) || request.resource.data.submitted_at is timestamp)
          && (!('created_at' in request.resource.data) || request.resource.data.created_at is timestamp)
          && (!('updated_at' in request.resource.data) || request.resource.data.updated_at is timestamp));
      allow delete: if isAdmin();
    }

    match /learning_state/{stateId} {
      allow read: if isAdmin() || isSelf(stateId);
      allow create, update: if isAdmin() || isSelf(stateId);
      allow delete: if isAdmin();
    }

    match /audio_lessons/{lessonId} {
      allow read, list: if canReadLearningContent(resource.data);
      allow create: if (isAdmin() || isApprovedTeacher())
        && isValidAudioLessonWrite()
        && (isAdmin() || request.resource.data.teacher_id == request.auth.uid);
      allow update: if canManageAudioLesson(resource.data)
        && isValidAudioLessonWrite()
        && request.resource.data.course_id == resource.data.course_id
        && request.resource.data.teacher_id == resource.data.teacher_id
        && request.resource.data.audio_url == resource.data.audio_url
        && request.resource.data.storage_path == resource.data.storage_path
        && request.resource.data.file_size == resource.data.file_size
        && request.resource.data.upload_date == resource.data.upload_date;
      allow delete: if canManageAudioLesson(resource.data);
    }

    match /recordings/{recordingId} {
      allow read: if canReadRecordingData(resource.data);
      allow create: if isTeacherOrAdmin();
      allow update: if isTeacherOrAdmin() && (isAdmin() || resource.data.teacher_id == request.auth.uid);
      allow delete: if isAdmin() || (isTeacherOrAdmin() && resource.data.teacher_id == request.auth.uid);
    }

    match /live_classes/{classId} {
      allow read: if canReadLiveClassData(resource.data);
      allow create: if isTeacherOrAdmin()
        && isValidLiveClassWrite()
        && (isAdmin() || request.resource.data.teacher_id == request.auth.uid)
        && request.resource.data.status == 'live';
      allow update: if (
          isLiveClassTeacherOrAdmin(resource.data)
          && isValidLiveClassWrite()
          && request.resource.data.teacher_id == resource.data.teacher_id
          && request.resource.data.course_id == resource.data.course_id
          && request.resource.data.created_at == resource.data.created_at
        );
      allow delete: if isAdmin();

      match /recordings/{recordingId} {
        allow read: if canReadLiveClassData(liveClassDoc(classId).data);
        allow write: if isLiveClassTeacherOrAdmin(liveClassDoc(classId).data);
      }
    }


    match /legal_audit_events/{eventId} {
      allow read: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow create: if isValidLegalAuditCreate();
      allow update, delete: if false;
    }

    match /privacy_requests/{requestId} {
      allow read: if isAdmin() || (isApprovedVerifiedUser() && resource.data.user_id == request.auth.uid);
      allow create: if isValidPrivacyRequestCreate();
      allow update: if isAdmin()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.type == resource.data.type
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.state in ['requested', 'reviewing', 'processing', 'completed', 'rejected']
        && request.resource.data.updated_at is timestamp;
      allow delete: if false;
    }

    match /user_notification_settings/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update: if isValidNotificationSettings(uid);
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /calls/{callId} {
      allow read: if isCallParticipantData(resource.data);
      allow create: if isValidCallCreate();
      allow update: if isValidCallUpdate();
      allow delete: if isAdmin();

      match /participants/{uid} {
        allow read: if exists(/databases/$(database)/documents/calls/$(callId))
          && isCallParticipantData(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create, update: if isValidCallParticipantWrite(callId, uid);
        allow delete: if isAdmin();
      }
    }

    // feedback collection
    match /feedback/{feedbackId} {
      allow read: if isApprovedVerifiedUser();
      allow create: if isApprovedVerifiedUser() && isValidFeedbackCreate();
      allow update, delete: if isAdmin();
    }

    // editable app settings (fees/social links/profile about content)
    match /app_settings/{docId} {
      allow read: if isApprovedVerifiedUser();
      allow write: if isAdmin() && (docId != 'platform' || isValidPlatformSettingsWrite(docId));
    }



    match /security_events_immutable/{id} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /admin_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /role_transition_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /notification_dedupe/{dedupeId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    match /notification_delivery_logs/{logId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Phase 2: quiz_attempt_locks — written by Cloud Functions only (anti-cheat).
    // Clients may only read their own lock documents for UX feedback.
    match /quiz_attempt_locks/{docId} {
      allow read: if isApprovedVerifiedUser() && resource.data.uid == request.auth.uid;
      allow write: if false; // Cloud Function Admin SDK only
    }

    // Phase 2: operation_dedupe — purely internal deduplication state.
    // No client read/write permitted; Cloud Function Admin SDK only.
    match /operation_dedupe/{docId} {
      allow read, write: if false;
    }

    // Phase 2: user_tokens — FCM/push notification token storage.
    // Only the token owner may read or write their own token document.
    // Field-level validation prevents injection of arbitrary fields.
    match /user_tokens/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'token', 'fcmToken', 'expoPushToken',
             'platform', 'updatedAt', 'userId'
           ])
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Phase 2: status_checks — server telemetry written by Cloud Functions.
    // Admins may read; no client writes permitted.
    match /status_checks/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Function Admin SDK only
    }

    // Deny all other document access by default.
    match /{document=**} {
      allow read, write: if false;
    }

    match /moderation_reports/{id} {
      allow read: if isModeratorOrAbove() || (isSignedIn() && resource.data.reporter_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.state == 'pending'
        && request.resource.data.severity in ['low','medium','high','critical']
        && request.resource.data.created_at is timestamp
        && request.resource.data.created_at_ms is number;
      allow update: if isModeratorOrAbove()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','reviewed_at','reviewed_by','moderation_notes','priority','actioned_at','actioned_by','actioned_at_ms'])
        && !(resource.data.accused_role in ['admin','super_admin'] && roleOf(request.auth.uid) == 'moderator');
      allow delete: if false;
    }

    match /moderation_evidence/{id} {
      allow read: if isModeratorOrAbove();
      allow create: if isSignedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /moderation_actions/{id} {
      allow read: if isModeratorOrAbove();
      allow create: if isModeratorOrAbove()
        && request.resource.data.actor_uid == request.auth.uid
        && request.resource.data.created_at is timestamp
        && !(request.resource.data.target_role in ['admin','super_admin'] && roleOf(request.auth.uid) == 'moderator');
      allow update, delete: if false;
    }

    match /moderation_analytics_daily/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /bug_reports/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /feature_suggestions/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /fatawa_questions/{questionId} {
      allow read: if (isSignedIn() && (
        isTeacherOrAdmin() || 
        resource.data.student_id == request.auth.uid || 
        (resource.data.is_public == true && resource.data.status == 'answered')
      ));
      allow create: if isSignedIn() && request.resource.data.student_id == request.auth.uid;
      allow update: if (isTeacherOrAdmin() || (isSignedIn() && resource.data.student_id == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /telemetry_errors/{errorId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /referral_records/{recordId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.referrer_uid == request.auth.uid || resource.data.referee_uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
